{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rscaps",
  "version": "0.1.0",
  "identifier": "com.rscaps.studio",
  "build": {
    "frontendDist": "../studio/dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npx vite --port 5177",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "rscaps studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
