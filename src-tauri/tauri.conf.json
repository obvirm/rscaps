{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rscaps",
  "version": "0.1.0",
  "identifier": "com.rscaps.studio",
  "build": {
    "frontendDist": "../studio/dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npx vite --port 5177",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "rscaps studio — faster tscaps alternative",
        "width": 1600,
        "height": 1000,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Faster, headless alternative to tscaps",
    "longDescription": "Browser-free animated caption rendering: a Rust engine (caption-core) emits one SVG per frame for the CLI, the web studio, and the desktop shell. Clean-room re-solve of the tscaps pipeline without the browser in the render path. Burns a 4-minute 1080p video in ~29 seconds headless, ~34s from the web export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
