// Picker — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Picker (cycles through options on click) ──────────────────────────────
export component Picker inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <[string]> options;
    in-out property <int> selected: 0;
    callback chosen(int);
    background: (root.is-dark ? Theme.bg0-dark : Theme.bg0-light);
    border-color: pick-popup.is-open || touch.has-hover ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
    border-width: 1px;
    border-radius: Theme.rSm;
    height: 34px;
    touch := TouchArea {
        clicked => {
            if (root.options.length == 0) { return; }
            if (pick-popup.is-open) { pick-popup.close(); } else { pick-popup.show(); }
        }
    }
    HorizontalLayout {
        padding-left: 10px; padding-right: 28px;
        alignment: space-between;
        Text {
            text: root.options.length > root.selected ? root.options[root.selected] : "(none)";
            color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
            font-size: 13px;
            overflow: elide;
            vertical-alignment: center;
        }
    }
    // Chevron as absolute overlay: layout cross-axis centering proved
    // unreliable (top-aligned in real browser), so center explicitly.
    // Plain Rectangle is non-interactive: clicks pass through to touch.
    Rectangle {
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        width: 12px; height: 12px;
        Path {
            width: 12px; height: 12px;
            fill: transparent;
            stroke: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
            stroke-width: 1.6px;
            commands: pick-popup.is-open ? "M 2.5 7.5 L 6 4 L 9.5 7.5" : "M 2.5 4.5 L 6 8 L 9.5 4.5";
        }
    }
    pick-popup := PopupWindow {
        // Outside clicks close it; inside clicks (incl. the opening one)
        // never auto-close: no open/close flicker.
        close-policy: close-on-click-outside;
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.options.length < 8 ? 8px + 30px * root.options.length : 230px;
        Rectangle {
            background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
            border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
            border-width: 1px;
            border-radius: Theme.rSm;
            drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            clip: true;
            // Instant open/close (native-select parity): no fade.
            flic := Flickable {
                width: parent.width;
                height: parent.height;
                content := VerticalLayout {
                    alignment: start;
                    spacing: 0px;
                    width: flic.width;
                    for option[i] in root.options: Rectangle {
                        height: 30px;
                        background: row-tap.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : (i == root.selected ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent);
                        row-tap := TouchArea {
                            clicked => {
                                root.selected = i;
                                root.chosen(i);
                                pick-popup.close();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            alignment: space-between;
                            Text {
                                text: option;
                                color: i == root.selected ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                                font-size: 12.5px;
                                vertical-alignment: center;
                            }
                            if i == root.selected: Path {
                                width: 10px; height: 8px;
                                fill: (root.is-dark ? Theme.accent-dark : Theme.accent-light);
                                commands: "M 0 3.8 L 0.9 3 L 3.1 5.2 L 8.7 0 L 9.6 0.9 L 3.1 7 Z";
                            }
                        }
                    }
                }
            }
        }
    }
}
