// StylePanel - tab "Style": field data-driven dari template.json
// (styleControls) + variant picker. Mirip tscaps StyleTab; model di-push
// Rust lewat DocParams.style-colors / style-floats / style-variants.
// Interaksi warna MVP: klik swatch = siklus 6 warna preset (tanpa popover).
import { Theme } from "./theme.slint";
import { DocParams, StyleColorItem, StyleFloatItem } from "./params_global.slint";
import { Section, FieldRow, Slider, Select } from "./controls.slint";
import { AppButton } from "./app_button.slint";


export component StylePanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    spacing: 0px;

    // Enam warna preset untuk siklus klik swatch.
    function swatch-next(cur: color) -> color {
        if (cur == #ffffff) { return #ffdd57; }
        if (cur == #ffdd57) { return #e85d3c; }
        if (cur == #e85d3c) { return #5b8def; }
        if (cur == #5b8def) { return #3ddc84; }
        if (cur == #3ddc84) { return #b06ae8; }
        return #ffffff;
    }

    Flickable {
        VerticalLayout {
            spacing: 0px;

            // Variant preset (bila template punya >=1 varian).
            if DocParams.style-variants.length > 0: Section {
                is-dark: root.is-dark;
                title: "PRESET";
                first: true;
                show-reset: false;
                Select {
                    is-dark: root.is-dark;
                    label: "Variant";
                    options: DocParams.style-variants;
                    selected <=> DocParams.variant-selected;
                    chosen(i) => { DocParams.variant-chosen(i); }
                }
            }

            // Warna per control.
            if DocParams.style-colors.length > 0: Section {
                is-dark: root.is-dark;
                title: "COLORS";
                first: DocParams.style-variants.length == 0;
                show-reset: false;
                for item[i] in DocParams.style-colors: FieldRow {
                    is-dark: root.is-dark;
                    label: item.label;
                    Rectangle {
                        height: 30px;
                        horizontal-stretch: 1;
                        border-radius: Theme.rSm;
                        background: root.is-dark ? Theme.bg1-dark : Theme.bg1-light;
                        border-color: root.is-dark ? Theme.border-dark : Theme.border-light;
                        border-width: 1px;
                        Rectangle {
                            x: 6px;
                            y: (parent.height - self.height) / 2;
                            width: 20px;
                            height: 20px;
                            border-radius: Theme.rSm;
                            background: item.value;
                            border-color: root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light;
                            border-width: 1px;
                        }
                        Text {
                            x: 34px;
                            width: parent.width - 70px;
                            height: 100%;
                            text: "click to cycle →";
                            color: root.is-dark ? Theme.fg2-dark : Theme.fg2-light;
                            font-size: 10.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            width: 100%; height: 100%;
                            clicked => {
                                DocParams.style-color-changed(
                                    item.id,
                                    root.swatch-next(item.value),
                                );
                            }
                        }
                    }
                }
            }

            // Float per control (slider inline).
            if DocParams.style-floats.length > 0: Section {
                is-dark: root.is-dark;
                title: "APPEARANCE";
                first: DocParams.style-variants.length == 0 && DocParams.style-colors.length == 0;
                show-reset: false;
                for item[i] in DocParams.style-floats: FieldRow {
                    is-dark: root.is-dark;
                    label: item.label;
                    Slider {
                        is-dark: root.is-dark;
                        minimum: item.min;
                        maximum: item.max;
                        suffix: item.unit;
                        value: item.value;
                        changed(v) => { DocParams.style-float-changed(item.id, v); }
                    }
                }
            }

            if DocParams.style-colors.length == 0 && DocParams.style-floats.length == 0: Text {
                text: "This template has no style controls.";
                color: root.is-dark ? Theme.fg2-dark : Theme.fg2-light;
                font-size: 11.5px;
                horizontal-alignment: center;
                padding-top: 16px;
            }

            AppButton {
                is-dark: root.is-dark;
                text: "Reset style";
                horizontal-stretch: 0;
                clicked => { DocParams.reset-style(); }
            }
        }
    }
}
