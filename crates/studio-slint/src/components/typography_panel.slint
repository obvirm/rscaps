// TypographyPanel - tab "Type": font size/weight, spacing, style toggles,
// case, align, color. Mirrors tscaps TypographySection with our atoms;
// values flow through the DocParams global (Rust patches caption-core).
import { Theme } from "./theme.slint";
import { DocParams } from "./params_global.slint";
import { Section, FieldRow, Slider, Toggle, Select, ColorSwatch } from "./controls.slint";
import { AppButton } from "./app_button.slint";


export component TypographyPanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    spacing: 0px;

    Flickable {
        VerticalLayout {
            spacing: 0px;

            Section {
                is-dark: root.is-dark;
                title: "FONT";
                first: true;
                show-reset: false;
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Size (px)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 20.0;
                        maximum: 300.0;
                        value <=> DocParams.font-size;
                        changed(v) => { DocParams.font-size-changed(v); }
                    }
                }
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Weight";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 100.0;
                        maximum: 900.0;
                        value: DocParams.font-weight;
                        changed(v) => { DocParams.font-weight-changed(Math.round(v / 100.0) * 100); }
                    }
                }
                ColorSwatch {
                    is-dark: root.is-dark;
                    label: "Color";
                    color: DocParams.color;
                    picked(c) => { DocParams.color-changed(c); }
                }
            }

            Section {
                is-dark: root.is-dark;
                title: "SPACING";
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Letter (em)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: -0.1;
                        maximum: 0.5;
                        value <=> DocParams.letter-spacing;
                        changed(v) => { DocParams.letter-spacing-changed(v); }
                    }
                }
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Word (em)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: -0.5;
                        maximum: 1.0;
                        value <=> DocParams.word-spacing;
                        changed(v) => { DocParams.word-spacing-changed(v); }
                    }
                }
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Line (em)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: -0.5;
                        maximum: 1.5;
                        value <=> DocParams.line-spacing;
                        changed(v) => { DocParams.line-spacing-changed(v); }
                    }
                }
            }

            Section {
                is-dark: root.is-dark;
                title: "STYLE";
                Toggle {
                    is-dark: root.is-dark;
                    label: "Italic";
                    checked <=> DocParams.italic;
                    toggled(v) => { DocParams.italic-changed(v); }
                }
                Toggle {
                    is-dark: root.is-dark;
                    label: "Underline";
                    checked <=> DocParams.underline;
                    toggled(v) => { DocParams.underline-changed(v); }
                }
                Toggle {
                    is-dark: root.is-dark;
                    label: "Strikethrough";
                    checked <=> DocParams.strikethrough;
                    toggled(v) => { DocParams.strikethrough-changed(v); }
                }
                Select {
                    is-dark: root.is-dark;
                    label: "Case";
                    options: ["None", "UPPERCASE", "lowercase"];
                    selected <=> DocParams.text-case;
                    chosen(i) => { DocParams.text-case-changed(i); }
                }
                Select {
                    is-dark: root.is-dark;
                    label: "Align";
                    options: ["Left", "Center", "Right"];
                    selected <=> DocParams.text-align;
                    chosen(i) => { DocParams.text-align-changed(i); }
                }
            }

            // Reset row.
            AppButton {
                is-dark: root.is-dark;
                text: "Reset typography";
                horizontal-stretch: 0;
                clicked => { DocParams.reset-typography(); }
            }
        }
    }
}
