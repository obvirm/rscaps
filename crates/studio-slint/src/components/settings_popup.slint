// SettingsPanel — settings popup card for the playbar gear (SPEED /
// NAVIGATE / LAYOUT GUIDE). Pure content; open/close owned by the
// invoker PopupWindow. Word row is honest-disabled: the engine emits
// segment timestamps only (no word timestamps yet).
import { Theme } from "./theme.slint";

export component SettingsPanel inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> rate-text: "1×";
    in-out property <string> guide-mode: "off";
    in property <bool> word-enabled: false;
    callback rate-step(int);
    callback nav-frame-step(int);
    callback nav-word-step(int);
    callback nav-scene-step(int);
    background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
    border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
    border-width: 1px;
    border-radius: Theme.rMd;
    drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    VerticalLayout {
        padding: 12px; spacing: 8px;
        Text {
            text: "SPEED · slower — faster";
            color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
            font-size: 11px; font-weight: 600;
        }
        HorizontalLayout {
            spacing: 8px; height: 28px; alignment: center;
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: step-back-tap.has-hover ? (root.is-dark ? Theme.bg3-dark : Theme.bg3-light) : (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                step-back-tap := TouchArea { clicked => { root.rate-step(-1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-left.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: root.rate-text;
                color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-family: "IBM Plex Mono"; font-size: 13px;
                min-width: 56px; horizontal-alignment: center; vertical-alignment: center;
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: step-fwd-tap.has-hover ? (root.is-dark ? Theme.bg3-dark : Theme.bg3-light) : (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                step-fwd-tap := TouchArea { clicked => { root.rate-step(1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-right.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
        }
        Text {
            text: "NAVIGATE";
            color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
            font-size: 11px; font-weight: 600;
        }
        HorizontalLayout {
            spacing: 8px; height: 28px;
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { clicked => { root.nav-frame-step(-1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-left.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "Frame";
                color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-size: 12.5px; width: 52px; vertical-alignment: center;
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { clicked => { root.nav-frame-step(1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-right.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "F + ←→";
                color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                font-family: "IBM Plex Mono"; font-size: 10.5px;
                horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px; height: 28px;
            opacity: root.word-enabled ? 1.0 : 0.45;
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { enabled: root.word-enabled; clicked => { root.nav-word-step(-1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-left.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "Word";
                color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-size: 12.5px; width: 52px; vertical-alignment: center;
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { enabled: root.word-enabled; clicked => { root.nav-word-step(1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-right.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "W + ←→";
                color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                font-family: "IBM Plex Mono"; font-size: 10.5px;
                horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px; height: 28px;
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { clicked => { root.nav-scene-step(-1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-left.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "Scene";
                color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-size: 12.5px; width: 52px; vertical-alignment: center;
            }
            Rectangle {
                width: 28px; height: 28px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
                TouchArea { clicked => { root.nav-scene-step(1); } }
                Image {
                    x: 7px; y: 7px; width: 14px; height: 14px;
                    source: @image-url("../assets/icons/chevron-right.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Text {
                text: "S + ←→";
                color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                font-family: "IBM Plex Mono"; font-size: 10.5px;
                horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center;
            }
        }
        Text {
            text: "LAYOUT GUIDE";
            color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
            font-size: 11px; font-weight: 600;
        }
        Rectangle {
            height: 28px; border-radius: Theme.rSm;
            background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
            border-color: root.guide-mode == "thirds" ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
            border-width: 1px;
            TouchArea { clicked => { root.guide-mode = "thirds"; } }
            Text {
                text: "view-only";
                color: root.guide-mode == "thirds" ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        Rectangle {
            height: 28px; border-radius: Theme.rSm;
            background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light);
            border-color: root.guide-mode == "off" ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
            border-width: 1px;
            TouchArea { clicked => { root.guide-mode = "off"; } }
            Text {
                text: "Off";
                color: root.guide-mode == "off" ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                font-size: 12px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}
