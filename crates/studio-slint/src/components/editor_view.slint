// EditorView — split from ui.slint (per-component files).
import { CommandBar } from "./command_bar.slint";
import { Inspector } from "./inspector.slint";
import { PreviewStage } from "./preview_stage.slint";
import { RailItem } from "./rail_item.slint";
import { TemplateItem } from "./template_item.slint";
import { Theme } from "./theme.slint";


// ── Editor view ────────────────────────────────────────────────────────────
export component EditorView inherits VerticalLayout {
    in-out property <string> project-name;
    in-out property <string> status;
    in property <bool> status-is-error: false;
    in-out property <string> active-rail: "templates";
    in-out property <string> doc-text;
    in-out property <int> template-selected: 0;
    in-out property <int> direction-selected: 0;
    // Model galeri template per seksi (didorong Rust) + teks search.
    in property <[TemplateItem]> template-viral: [];
    in property <[TemplateItem]> template-modern: [];
    in property <[TemplateItem]> template-classic: [];
    in property <[TemplateItem]> template-key: [];
    in property <[TemplateItem]> template-lab: [];
    in-out property <string> template-search-text: "";
    callback template-search(string);
    in property <bool> has-video: false;
    in property <float> video-aspect: 16 / 9;
    in property <string> stage-chip: "frame 0 - 0.00s";
    in property <bool> playing: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    // Lebar panel kanan (drag-resize via handle, 240..520px).
    in-out property <length> inspector-w: 320px;
    // Mode layout guide (diangkat ke App agar salinan reveal ikut).
    in-out property <string> guide-mode: "off";
    // Mode sempit dari App (Rust-driven via width-poll — kondisi lebar
    // di Slint yang menggerakkan struktur bikin binding loop).
    in property <bool> is-narrow: false;
    // Diteruskan ke Playbar via PreviewStage (ambang dihitung Rust dari
    // lebar kolom tengah, bukan jendela).
    in property <bool> playbar-narrow: false;
    property <length> resize-x0: 0px;
    property <length> resize-w0: 320px;
    in property <string> time-text: "0:00.000";
    in property <string> duration-text: "0:00.000";
    in property <int> frame: 0;
    in property <int> scrub-max: 1;
    callback back;
    callback export;
    callback name-edited(string);
    callback template-chosen(int);
    callback direction-chosen(int);
    callback apply;
    callback toggle-play;
    callback seek(int);
    callback rate-step(int);
    callback nav-frame-step(int);
    callback nav-word-step(int);
    callback nav-scene-step(int);
    callback import-video;
    callback attach-video;
    callback export-subs(string);
    callback scrub-to(float);
    callback volume-to(float);
    callback mute-toggle;
    callback undo;
    callback redo;
    in property <string> rate-text: "1×";
    in property <bool> word-enabled: false;
    in property <float> volume-frac: 1.0;
    callback toggle-theme;
    in property <bool> is-dark: true;
    in property <image> preview-image;
    // Teks cue aktif (didorong Rust tiap frame) untuk overlay preview.
    in property <string> overlay-text: "";
    // Gaya overlay template (didorong Rust saat kartu diklik).
    in property <float> overlay-fs: 7.0;
    in property <int> overlay-fw: 800;
    in property <color> overlay-fg: #ffffff;
    in property <color> overlay-bg: #000000;
    in property <bool> overlay-bg-on: false;
    in property <float> overlay-br: 0.0;
    in property <float> overlay-pdx: 0.0;
    in property <float> overlay-pdy: 0.0;
    in property <float> overlay-y: 0.82;
    in property <string> overlay-fam: "";
    // Overlay caption asli render_frame (paritas main).
    in property <image> overlay-image;
    in property <bool> overlay-live: false;
    spacing: 0px;

    CommandBar {
        is-narrow: root.is-narrow;
        project-name: root.project-name;
        status: root.status;
        status-is-error: root.status-is-error;
        is-dark: root.is-dark;
        back => { root.back(); }
        export => { root.export(); }
        name-edited(t) => { root.name-edited(t); }
        toggle-theme => { root.toggle-theme(); }
        import-video => { root.import-video(); }
    }

    Rectangle {
        vertical-stretch: 1;
        if !root.is-narrow : HorizontalLayout {
            padding-top: 10px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;
            spacing: 0px;

            VerticalLayout {
                width: 72px;
                alignment: center;
                Rectangle {
                    width: 72px;
                background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light); border-color: (root.is-dark ? Theme.border-dark : Theme.border-light); border-width: 1px;
                border-radius: Theme.rLg;
                drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 3px;
                VerticalLayout {
                    padding: 4px; spacing: 2px; alignment: start;
                    RailItem { is-dark: root.is-dark; id: "templates"; label: "Templates"; active: root.active-rail == "templates"; clicked => { root.active-rail = "templates"; } }
                    RailItem { is-dark: root.is-dark; id: "transcript"; label: "Transcript"; active: root.active-rail == "transcript"; clicked => { root.active-rail = "transcript"; } }
                    RailItem { is-dark: root.is-dark; id: "typography"; label: "Type"; active: root.active-rail == "typography"; clicked => { root.active-rail = "typography"; } }
                    RailItem { is-dark: root.is-dark; id: "style"; label: "Style"; active: root.active-rail == "style"; clicked => { root.active-rail = "style"; } }
                    RailItem { is-dark: root.is-dark; id: "position"; label: "Position"; active: root.active-rail == "position"; clicked => { root.active-rail = "position"; } }
                    RailItem { is-dark: root.is-dark; id: "motion"; label: "Motion"; active: root.active-rail == "motion"; clicked => { root.active-rail = "motion"; } }
                    RailItem { is-dark: root.is-dark; id: "effects"; label: "Effects"; active: root.active-rail == "effects"; clicked => { root.active-rail = "effects"; } }
                    RailItem { is-dark: root.is-dark; id: "layout"; label: "Layout"; active: root.active-rail == "layout"; clicked => { root.active-rail = "layout"; } }
                    RailItem { is-dark: root.is-dark; id: "code"; label: "Code"; active: root.active-rail == "code"; clicked => { root.active-rail = "code"; } }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                VerticalLayout {
                    padding-top: 0px; padding-bottom: 0px; padding-left: 10px; padding-right: 12px;
                    spacing: 10px;
                    PreviewStage {
                        playbar-narrow: root.playbar-narrow;
                        is-dark: root.is-dark;
                        vertical-stretch: 1;
                        has-video: root.has-video;
                        video-aspect: root.video-aspect;
                        frame-image: root.preview-image;
                        overlay-text: root.overlay-text;
                        overlay-fs: root.overlay-fs;
                        overlay-fw: root.overlay-fw;
                        overlay-fg: root.overlay-fg;
                        overlay-bg: root.overlay-bg;
                        overlay-bg-on: root.overlay-bg-on;
                        overlay-br: root.overlay-br;
                        overlay-pdx: root.overlay-pdx;
                        overlay-pdy: root.overlay-pdy;
                        overlay-y: root.overlay-y;
                        overlay-fam: root.overlay-fam;
                        overlay-image: root.overlay-image;
                        overlay-live: root.overlay-live;
                        volume: root.volume-frac;
                        guide-mode <=> root.guide-mode;
                        scrub-to(f) => { root.scrub-to(f); }
                        volume-to(f) => { root.volume-to(f); }
                        mute-toggle => { root.mute-toggle(); }
                        undo => { root.undo(); }
                        redo => { root.redo(); }
                        can-undo: root.can-undo;
                        can-redo: root.can-redo;
                        rate-text: root.rate-text;
                        word-enabled: root.word-enabled;
                        stage-chip: root.stage-chip;
                        playing: root.playing;
                        time-text: root.time-text;
                        duration-text: root.duration-text;
                        frame: root.frame;
                        scrub-max: root.scrub-max;
                        attach-video => { root.attach-video(); }
                        toggle-play => { root.toggle-play(); }
                        seek(f) => { root.seek(f); }
                        rate-step(d) => { root.rate-step(d); }
                        nav-frame-step(d) => { root.nav-frame-step(d); }
                        nav-word-step(d) => { root.nav-word-step(d); }
                        nav-scene-step(d) => { root.nav-scene-step(d); }
                    }
                }
            }

            Rectangle {
                width: 12px;
                Rectangle {
                    x: (parent.width - 2px) / 2; y: (parent.height - 44px) / 2;
                    width: 2px; height: 44px; border-radius: 1px; background: (root.is-dark ? Theme.border-dark : Theme.border-light);
                }
            }

            Rectangle {
                width: root.inspector-w;
                // Wadah pegang bg/border/radius/shadow (TANPA clip) agar
                // bayangan tak terpotong; Inspector di dalam tetap clip isi.
                background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
                border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
                border-width: 1px;
                border-radius: Theme.rLg;
                drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 3px;
                Inspector {
                    is-dark: root.is-dark;
                    width: parent.width; height: parent.height;
                    title: root.active-rail == "templates" ? "Templates" : root.active-rail == "code" ? "Code" : root.active-rail;
                    active-rail: root.active-rail;
                    doc-text: root.doc-text;
                    template-selected <=> root.template-selected;
                    direction-selected <=> root.direction-selected;
                    template-viral: root.template-viral;
                    template-modern: root.template-modern;
                    template-classic: root.template-classic;
                    template-key: root.template-key;
                    template-lab: root.template-lab;
                    template-search-text <=> root.template-search-text;
                    template-chosen(i) => { root.template-chosen(i); }
                    template-search(t) => { root.template-search(t); }
                    direction-chosen(i) => { root.direction-chosen(i); }
                    apply => { root.apply(); }
                }
                // Drag handle: strip 10px di tepi kiri panel. Matematika
                // delta MURNI: (w0 + x0 - mx) tanpa root.width — memakai
                // lebar-yang-sedang-di-set di kedua sisi = feedback loop
                // (panel meluncur ke kanan tiap move). Koordinat lokal
                // handle stabil karena hanya translasi. Panel tumbuh ke
                // kiri, tepi kanan selalu nempel viewport.
                // BARRIER: max geser = min(520, lebar-window - 600) agar
                // panel tak pernah kedorong keluar layar di jendela kecil
                // (600 = row-min 584 + margin border; playbar ramping 448).
                property <length> drag-max: Math.max(240px, Math.min(520px, root.width - 600px));
                resize-handle := TouchArea {
                    x: 0px; y: 0px; width: 10px; height: parent.height;
                    mouse-cursor: col-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.resize-x0 = resize-handle.mouse-x;
                            root.resize-w0 = root.inspector-w;
                        }
                        if (e.kind == PointerEventKind.move && resize-handle.pressed) {
                            root.inspector-w = Math.max(240px, Math.min(drag-max, root.resize-w0 + root.resize-x0 - resize-handle.mouse-x));
                        }
                    }
                }
            }
        }
        // Cabang sempit (paritas tscaps): tengah fleksibel, inspector
        // full-width 240px, rail jadi bar horizontal scroll di bawah.
        // Instance PreviewStage/Inspector kedua aman diduplikat: state
        // persist di root/Rust, `if` memastikan cuma satu yang hidup.
        if root.is-narrow : VerticalLayout {
            padding-top: 10px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;
            spacing: 10px;
            PreviewStage {
                playbar-narrow: root.playbar-narrow;
                vertical-stretch: 1;
                is-dark: root.is-dark;
                has-video: root.has-video;
                video-aspect: root.video-aspect;
                frame-image: root.preview-image;
                overlay-text: root.overlay-text;
                overlay-fs: root.overlay-fs;
                overlay-fw: root.overlay-fw;
                overlay-fg: root.overlay-fg;
                overlay-bg: root.overlay-bg;
                overlay-bg-on: root.overlay-bg-on;
                overlay-br: root.overlay-br;
                overlay-pdx: root.overlay-pdx;
                overlay-pdy: root.overlay-pdy;
                overlay-y: root.overlay-y;
                overlay-fam: root.overlay-fam;
                overlay-image: root.overlay-image;
                overlay-live: root.overlay-live;
                volume: root.volume-frac;
                guide-mode <=> root.guide-mode;
                scrub-to(f) => { root.scrub-to(f); }
                volume-to(f) => { root.volume-to(f); }
                mute-toggle => { root.mute-toggle(); }
                undo => { root.undo(); }
                redo => { root.redo(); }
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                rate-text: root.rate-text;
                word-enabled: root.word-enabled;
                stage-chip: root.stage-chip;
                playing: root.playing;
                time-text: root.time-text;
                duration-text: root.duration-text;
                frame: root.frame;
                scrub-max: root.scrub-max;
                attach-video => { root.attach-video(); }
                toggle-play => { root.toggle-play(); }
                seek(f) => { root.seek(f); }
                rate-step(d) => { root.rate-step(d); }
                nav-frame-step(d) => { root.nav-frame-step(d); }
                nav-word-step(d) => { root.nav-word-step(d); }
                nav-scene-step(d) => { root.nav-scene-step(d); }
            }
            Rectangle {
                height: 240px;
                background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
                border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
                border-width: 1px;
                border-radius: Theme.rLg;
                drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 3px;
                Inspector {
                    is-dark: root.is-dark;
                    width: parent.width; height: parent.height;
                    title: root.active-rail == "templates" ? "Templates" : root.active-rail == "code" ? "Code" : root.active-rail;
                    active-rail: root.active-rail;
                    doc-text: root.doc-text;
                    template-selected <=> root.template-selected;
                    direction-selected <=> root.direction-selected;
                    template-viral: root.template-viral;
                    template-modern: root.template-modern;
                    template-classic: root.template-classic;
                    template-key: root.template-key;
                    template-lab: root.template-lab;
                    template-search-text <=> root.template-search-text;
                    template-chosen(i) => { root.template-chosen(i); }
                    template-search(t) => { root.template-search(t); }
                    direction-chosen(i) => { root.direction-chosen(i); }
                    apply => { root.apply(); }
                }
            }
            Rectangle {
                height: 70px;
                background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
                border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
                border-width: 1px;
                border-radius: Theme.rLg;
                drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
                drop-shadow-blur: 12px;
                drop-shadow-offset-y: 3px;
                Flickable {
                    width: 100%; height: 100%;
                    // Ukuran konten eksplisit (9 item × 64px + padding 12px +
                    // spacing 16px = 604×70) — binding ke ukuran child bikin
                    // loop dengan content-rect Flickable.
                    content-width: 604px; content-height: 70px;
                    rail-row := HorizontalLayout {
                        width: 604px; height: 70px;
                        padding: 6px; spacing: 2px;
                        RailItem { is-dark: root.is-dark; id: "templates"; label: "Templates"; active: root.active-rail == "templates"; clicked => { root.active-rail = "templates"; } }
                        RailItem { is-dark: root.is-dark; id: "transcript"; label: "Transcript"; active: root.active-rail == "transcript"; clicked => { root.active-rail = "transcript"; } }
                        RailItem { is-dark: root.is-dark; id: "typography"; label: "Type"; active: root.active-rail == "typography"; clicked => { root.active-rail = "typography"; } }
                        RailItem { is-dark: root.is-dark; id: "style"; label: "Style"; active: root.active-rail == "style"; clicked => { root.active-rail = "style"; } }
                        RailItem { is-dark: root.is-dark; id: "position"; label: "Position"; active: root.active-rail == "position"; clicked => { root.active-rail = "position"; } }
                        RailItem { is-dark: root.is-dark; id: "motion"; label: "Motion"; active: root.active-rail == "motion"; clicked => { root.active-rail = "motion"; } }
                        RailItem { is-dark: root.is-dark; id: "effects"; label: "Effects"; active: root.active-rail == "effects"; clicked => { root.active-rail = "effects"; } }
                        RailItem { is-dark: root.is-dark; id: "layout"; label: "Layout"; active: root.active-rail == "layout"; clicked => { root.active-rail = "layout"; } }
                        RailItem { is-dark: root.is-dark; id: "code"; label: "Code"; active: root.active-rail == "code"; clicked => { root.active-rail = "code"; } }
                    }
                }
            }
        }
    }
}
