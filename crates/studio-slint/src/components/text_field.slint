// TextField — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Text field ─────────────────────────────────────────────────────────────
export component TextField inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    // Live: tiap ketikan (untuk search galeri). Pendengar lama yang
    // hanya pakai edited() tak terpengaruh (no-op bila tak di-wire).
    callback live(string);
    changed text => { root.live(root.text); }
    background: textinput.has-focus || touch.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
    border-color: textinput.has-focus ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (touch.has-hover ? (root.is-dark ? Theme.border-dark : Theme.border-light) : transparent);
    border-width: 1px;
    border-radius: Theme.rSm;
    height: 30px;
    clip: true;
    touch := TouchArea { width: 100%; height: 100%; }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        // Single child stretches to fill — alignment:start left most of the
        // field non-interactive (clicks missed the narrow TextInput).
        textinput := TextInput {
            text <=> root.text;
            color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
            accepted => { root.edited(root.text); }
        }
    }
    // Placeholder (properti ada tapi tak pernah dilukis — search galeri
    // butuh affordance saat kosong).
    if root.text == "" && root.placeholder != "" : Text {
        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
        text: root.placeholder;
        color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}
