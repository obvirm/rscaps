// PreviewStage — split from ui.slint (per-component files).
import { Playbar } from "./playbar.slint";
import { Theme } from "./theme.slint";


// ── Preview stage ──────────────────────────────────────────────────────────
export component PreviewStage inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    in property <bool> has-video: false;
    in property <image> frame-image;
    // Rasio asli video (w/h) — frame preview mengikuti source 1:1
    // (paritas PreviewStage.svelte: aspect-ratio + contain di area).
    in property <float> video-aspect: 16 / 9;
    callback attach-video;
    in property <string> stage-chip;
    in property <bool> playing;
    in property <string> time-text;
    in property <string> duration-text;
    in property <int> frame;
    in property <int> scrub-max;
    callback toggle-play;
    callback seek(int);
    callback rate-step(int);
    callback nav-frame-step(int);
    callback nav-word-step(int);
    callback nav-scene-step(int);
    callback scrub-to(float);
    callback volume-to(float);
    callback mute-toggle;
    callback undo;
    callback redo;
    in property <float> volume: 1.0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <string> rate-text: "1×";
    in-out property <string> guide-mode: "off";
    in property <bool> word-enabled: false;
    in property <bool> playbar-narrow: false;
    // Teks cue aktif dari Rust (active_cue_at); kosong = tak ada caption.
    in property <string> overlay-text: "";
    // Gaya overlay dari template terpilih (didorong Rust saat kartu diklik).
    in property <float> overlay-fs: 7.0;
    in property <int> overlay-fw: 800;
    in property <color> overlay-fg: #ffffff;
    in property <color> overlay-bg: #000000;
    in property <bool> overlay-bg-on: false;
    in property <float> overlay-br: 0.0;
    in property <float> overlay-pdx: 0.0;
    in property <float> overlay-pdy: 0.0;
    in property <float> overlay-y: 0.82;
    in property <string> overlay-fam: "";
    // Overlay caption asli (render_frame caption-core -> SVG -> browser
    // render via slint::Image::load_from_svg_data, paritas main). Saat
    // live=true, teks Slint tiruan (overlay-text) disembunyikan.
    in property <image> overlay-image;
    in property <bool> overlay-live: false;
    spacing: 12px;

    Rectangle {
        // Container polos seperti .preview-region di tscaps — TANPA
        // background/border/radius/clip (itu bikin "garis" jelek).
        horizontal-stretch: 1;
        vertical-stretch: 1;

        Rectangle {
            // Kartu video (paritas Svelte .video-box): aspect-ratio mengikuti
            // video asli (bisa 9:16, 4:3, dsb) — background bg0 jadi bar
            // letterbox. Radius + border + shadow-md, inset 12px dari tepi
            // container supaya shadow muat.
            //
            // Opsi A2 (WASM preview): saat has-video, background kartu jadi
            // TRANSPARAN — lubang di kanvas Slint tempat DOM <video> di
            // belakang kanvas terlihat (rect video di-sync Rust dari
            // matematika layout yang SAMA dengan binding di bawah; konstanta
            // harus ikut berubah bersama). Border/shadow kartu pindah ke
            // CSS #preview-video (index.html). Tanpa video (home / empty
            // state), kartu tampil normal dengan bg0.
            property <length> avail-w: Math.max(0px, parent.width - 24px);
            property <length> avail-h: Math.max(0px, parent.height - 24px);
            property <length> fw: Math.min(avail-w, avail-h * root.video-aspect);
            property <length> fh: fw / root.video-aspect;
            x: (parent.width - fw) / 2;
            y: (parent.height - fh) / 2;
            width: fw;
            height: fh;
            background: root.has-video ? #00000000 : (root.is-dark ? Theme.bg0-dark : Theme.bg0-light);
            border-radius: Theme.rLg;
            border-width: root.has-video ? 0px : 1px;
            border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
            clip: true;
            drop-shadow-color: root.has-video ? #00000000 : (root.is-dark ? #141416F2 : #3c322899);
            drop-shadow-blur: root.has-video ? 0px : 12px;
            drop-shadow-offset-y: root.has-video ? 0px : 3px;
            if !root.has-video: TouchArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                clicked => { root.attach-video(); }
            }
            // Frame preview (Fase 3/native): diisi dari FFmpeg -> SharedPixelBuffer.
            // Di WASM jalur ini KOSONG (video DOM di belakang kanvas);
            // Image kosong tidak menggambar apa pun.
            if root.has-video: Image {
                width: 100%; height: 100%;
                source: root.frame-image;
                image-fit: contain;
            }
            // Overlay caption render_frame (viewBox 1920×1080).
            // Skala mengikuti TINGGI video (bukan contain/fill):
            //   scale = card_h / 1080 → caption proporsional dgn tinggi video,
            //   tidak stretch, tidak menyusut. Width overflow di-clip card.
            // Untuk video 16:9 sama dgn contain; portrait = caption besar
            // proporsional; landscape lebar = caption tetap proporsional.
            if root.overlay-live && root.has-video: Image {
                property <float> scale-f: parent.height / 1080px;
                property <length> ow: 1920px * self.scale-f;
                property <length> oh: parent.height;
                x: (parent.width - self.ow) / 2;
                y: 0px;
                width: self.ow;
                height: self.oh;
                source: root.overlay-image;
                image-fit: ImageFit.fill;
            }
            // Overlay caption live (slice 1: teks cue aktif; slice 2a: gaya
            // template). Band bg (bila template punya bg-color) + teks wrap
            // tengah; posisi vertikal = fraksi tinggi frame template.
            // Satu scope `if` (pola chip): bg boleh ref `cap` yang di bawah.
            // Hanya tampil saat overlay asli (overlay-live) belum hidup.
            property <float> cap-fpx: Math.max(18.0, parent.height / 1px * root.overlay-fs / 100.0);
            if root.overlay-text != "" && !root.overlay-live: Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                if root.overlay-bg-on : Rectangle {
                    x: 12px; width: parent.width - 24px;
                    y: parent.height * root.overlay-y - cap.height / 2 - root.overlay-pdy * cap-fpx * 1px;
                    height: cap.height + root.overlay-pdy * 2.0 * cap-fpx * 1px;
                    background: root.overlay-bg;
                    border-radius: root.overlay-br * cap-fpx * 1px;
                }
                cap := Text {
                    x: 0; y: parent.height * root.overlay-y - self.height / 2;
                    width: parent.width;
                    text: root.overlay-text;
                    color: root.overlay-fg;
                    font-size: cap-fpx * 1px;
                    font-weight: root.overlay-fw;
                    font-family: root.overlay-fam;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            // Chip kecil kiri-bawah di atas frame (paritas .stage-chip
            // tscaps: pil selebar teks, left 10 bottom 8). Background ikut
            // lebar teks via sibling binding (Text auto-size ke konten);
            // background dulu agar teks melukis di atasnya.
            Rectangle {
                x: 10px; y: parent.height - 26px;
                width: chip-text.width + 14px; height: 18px;
                background: #0c0c0e90; border-radius: 999px;
            }
            chip-text := Text {
                x: 17px; y: parent.height - 26px;
                height: 18px;
                text: root.stage-chip;
                color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-family: "IBM Plex Mono"; font-size: 11px;
                vertical-alignment: center;
            }
            // Layout guide overlay (view-only, non-interaktif): grid
            // thirds di atas frame. Terakhir agar melukis paling atas.
            if root.guide-mode == "thirds": Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                Rectangle {
                    x: parent.width / 3 - 0.5px; y: 0px; width: 1px; height: parent.height;
                    background: (root.is-dark ? #ffffff38 : #00000038);
                }
                Rectangle {
                    x: parent.width * 2 / 3 - 0.5px; y: 0px; width: 1px; height: parent.height;
                    background: (root.is-dark ? #ffffff38 : #00000038);
                }
                Rectangle {
                    x: 0px; y: parent.height / 3 - 0.5px; width: parent.width; height: 1px;
                    background: (root.is-dark ? #ffffff38 : #00000038);
                }
                Rectangle {
                    x: 0px; y: parent.height * 2 / 3 - 0.5px; width: parent.width; height: 1px;
                    background: (root.is-dark ? #ffffff38 : #00000038);
                }
            }
        }
    }

    // Content-height only: the stage above already owns the leftover
    // space (vertical-stretch: 1). Letting Playbar stretch too split the
    // remainder and grew the card into a huge empty box.
    Playbar {
        vertical-stretch: 0;
        is-narrow: root.playbar-narrow;
        is-dark: root.is-dark;
        playing: root.playing;
        time-text: root.time-text;
        duration-text: root.duration-text;
        frame: root.frame;
        scrub-max: root.scrub-max;
        volume: root.volume;
        rate-text: root.rate-text;
        guide-mode <=> root.guide-mode;
        word-enabled: root.word-enabled;
        toggle-play => { root.toggle-play(); }
        seek(f) => { root.seek(f); }
        rate-step(d) => { root.rate-step(d); }
        nav-frame-step(d) => { root.nav-frame-step(d); }
        nav-word-step(d) => { root.nav-word-step(d); }
        nav-scene-step(d) => { root.nav-scene-step(d); }
        scrub-to(f) => { root.scrub-to(f); }
        volume-to(f) => { root.volume-to(f); }
        mute-toggle => { root.mute-toggle(); }
        undo => { root.undo(); }
        redo => { root.redo(); }
        can-undo: root.can-undo;
        can-redo: root.can-redo;
    }
}
