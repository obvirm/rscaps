// PositionPanel - tab "Position": anchor grid 3×3, offset slider, rotasi.
// Mirip tscaps PositionSection + RotationSection; nilai via DocParams.
import { Theme } from "./theme.slint";
import { DocParams } from "./params_global.slint";
import { Section, FieldRow, Slider, AnchorGrid } from "./controls.slint";
import { AppButton } from "./app_button.slint";


export component PositionPanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    spacing: 0px;

    Flickable {
        VerticalLayout {
            spacing: 0px;

            Section {
                is-dark: root.is-dark;
                title: "ANCHOR";
                first: true;
                show-reset: false;
                AnchorGrid {
                    is-dark: root.is-dark;
                    anchor: DocParams.anchor;
                    anchor-changed(i) => { DocParams.anchor-changed(i); }
                }
            }

            Section {
                is-dark: root.is-dark;
                title: "OFFSET";
                show-reset: false;
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Vertical";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 0.0;
                        maximum: 1.0;
                        value <=> DocParams.v-offset;
                        changed(v) => { DocParams.v-offset-changed(v); }
                    }
                }
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Horizontal";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 0.0;
                        maximum: 1.0;
                        value <=> DocParams.h-offset;
                        changed(v) => { DocParams.h-offset-changed(v); }
                    }
                }
            }

            Section {
                is-dark: root.is-dark;
                title: "ROTATION";
                show-reset: false;
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Angle";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: -180.0;
                        maximum: 180.0;
                        suffix: "°";
                        value <=> DocParams.angle;
                        changed(v) => { DocParams.angle-changed(v); }
                    }
                }
            }

            AppButton {
                is-dark: root.is-dark;
                text: "Reset position";
                horizontal-stretch: 0;
                clicked => { DocParams.reset-position(); }
            }
        }
    }
}
