// TranscribeOverlay — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Transcribe overlay ─────────────────────────────────────────────────────
export component TranscribeOverlay inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <int> pct: 0;
    in property <string> title: "Preparing the engine.";
    in property <string> sub: "Loading the transcription engine.";
    callback cancel;
    width: 100%; height: 100%;
    background: #000000d1;
    TouchArea { x: 0; y: 0; width: parent.width; height: parent.height; clicked => { root.cancel(); } }
    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center;
        HorizontalLayout {
            width: 100%;
            alignment: center;
            Rectangle {
                width: Math.min(460px, parent.width); horizontal-stretch: 0;
                VerticalLayout {
                    alignment: center; spacing: 18px;
                    padding-top: 40px; padding-bottom: 40px; padding-left: 48px; padding-right: 48px;
                    HorizontalLayout {
                        alignment: center; horizontal-stretch: 0;
                        Text { text: "rs"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 22px; font-weight: 800; vertical-alignment: center; }
                        Text { text: "caps"; color: (root.is-dark ? Theme.accent-dark : Theme.accent-light); font-size: 22px; font-weight: 800; vertical-alignment: center; }
                    }
                    Text { text: root.pct + "%"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-family: "IBM Plex Mono"; font-size: 48px; font-weight: 700; horizontal-alignment: center; }
                    Rectangle {
                        width: 320px; height: 6px; horizontal-stretch: 0;
                        background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light); border-radius: 999px;
                        Rectangle {
                            x: 0; y: 0; height: 6px;
                            width: parent.width * root.pct / 100;
                            background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); border-radius: 999px;
                        }
                    }
                    Rectangle { height: 6px; }
                    Text { text: root.title; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: root.sub; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }
}
