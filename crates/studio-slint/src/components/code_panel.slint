// CodePanel — split from ui.slint (per-component files).
import { AppButton } from "./app_button.slint";
import { Picker } from "./picker.slint";
import { SectionLabel } from "./section_label.slint";
import { Theme } from "./theme.slint";


// ── Code panel ─────────────────────────────────────────────────────────────
export component CodePanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    in-out property <string> doc-text;
    in-out property <int> direction-selected: 0;
    callback apply;
    callback direction-chosen(int);
    spacing: 10px;
    SectionLabel { is-dark: root.is-dark; text: "DOCUMENT (JSON)"; }
    Rectangle {
        background: (root.is-dark ? Theme.bg0-dark : Theme.bg0-light); border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
        border-width: 1px; border-radius: Theme.rSm;
        vertical-stretch: 1;
        clip: true;
        Text {
            x: 10px; y: 10px; width: parent.width - 20px;
            text: root.doc-text;
            color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-family: "IBM Plex Mono"; font-size: 12px;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Text { text: "Direction"; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 12px; vertical-alignment: center; }
        Picker {
            is-dark: root.is-dark;
            width: 120px;
            options: ["auto", "ltr", "rtl"];
            selected <=> root.direction-selected;
            chosen(i) => { root.direction-chosen(i); }
        }
        AppButton { is-dark: root.is-dark; text: "Apply + prepare"; accent: true; clicked => { root.apply(); } }
    }
}
