// SectionLabel — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Section label (uppercase) ──────────────────────────────────────────────
export component SectionLabel inherits Text {
    in property <bool> is-dark: Theme.is-dark;
    color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
    font-size: 11px;
    font-weight: 600;
}
