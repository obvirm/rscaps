// TemplatesPanel — galeri grid ala tscaps (ide/layout saja; thumbnail
// snapshot per kartu menyusul). Search + seksi kategori + grid 3 kolom;
// model per seksi + filter dikerjakan Rust (Slint tak bisa filter).
import { SectionLabel } from "./section_label.slint";
import { TemplateCard } from "./template_card.slint";
import { TemplateItem } from "./template_item.slint";
import { TextField } from "./text_field.slint";
import { Theme } from "./theme.slint";


// ── Templates panel ──────────────────────────────────────────────────────
export component TemplatesPanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    in-out property <int> template-selected: 0;
    in property <[TemplateItem]> template-viral: [];
    in property <[TemplateItem]> template-modern: [];
    in property <[TemplateItem]> template-classic: [];
    in property <[TemplateItem]> template-key: [];
    in property <[TemplateItem]> template-lab: [];
    in-out property <string> search-text: "";
    callback template-chosen(int);
    callback template-search(string);
    spacing: 8px;
    TextField {
        is-dark: root.is-dark;
        text <=> root.search-text;
        placeholder: "Search templates";
        live(t) => { root.template-search(t); }
    }
    SectionLabel { is-dark: root.is-dark; text: "< ALL TEMPLATES"; }
    flick := Flickable {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        VerticalLayout {
            // Lebar viewport eksplisit (bukan content) agar tak binding loop.
            width: flick.viewport-width;
            spacing: 10px;
            if root.template-viral.length > 0 : VerticalLayout {
                spacing: 8px;
                SectionLabel { is-dark: root.is-dark; text: "VIRAL"; }
                GridLayout {
                    spacing: 8px;
                    for item in root.template-viral : TemplateCard {
                        row: item.row;
                        col: item.col;
                        is-dark: root.is-dark;
                        label: item.name;
                        active: item.idx == root.template-selected;
                        picked => { root.template-chosen(item.idx); }
                    }
                }
            }
            if root.template-modern.length > 0 : VerticalLayout {
                spacing: 8px;
                SectionLabel { is-dark: root.is-dark; text: "MODERN"; }
                GridLayout {
                    spacing: 8px;
                    for item in root.template-modern : TemplateCard {
                        row: item.row;
                        col: item.col;
                        is-dark: root.is-dark;
                        label: item.name;
                        active: item.idx == root.template-selected;
                        picked => { root.template-chosen(item.idx); }
                    }
                }
            }
            if root.template-classic.length > 0 : VerticalLayout {
                spacing: 8px;
                SectionLabel { is-dark: root.is-dark; text: "CLASSIC"; }
                GridLayout {
                    spacing: 8px;
                    for item in root.template-classic : TemplateCard {
                        row: item.row;
                        col: item.col;
                        is-dark: root.is-dark;
                        label: item.name;
                        active: item.idx == root.template-selected;
                        picked => { root.template-chosen(item.idx); }
                    }
                }
            }
            if root.template-key.length > 0 : VerticalLayout {
                spacing: 8px;
                SectionLabel { is-dark: root.is-dark; text: "KEY MOMENTS"; }
                GridLayout {
                    spacing: 8px;
                    for item in root.template-key : TemplateCard {
                        row: item.row;
                        col: item.col;
                        is-dark: root.is-dark;
                        label: item.name;
                        active: item.idx == root.template-selected;
                        picked => { root.template-chosen(item.idx); }
                    }
                }
            }
            if root.template-lab.length > 0 : VerticalLayout {
                spacing: 8px;
                SectionLabel { is-dark: root.is-dark; text: "LAB"; }
                GridLayout {
                    spacing: 8px;
                    for item in root.template-lab : TemplateCard {
                        row: item.row;
                        col: item.col;
                        is-dark: root.is-dark;
                        label: item.name;
                        active: item.idx == root.template-selected;
                        picked => { root.template-chosen(item.idx); }
                    }
                }
            }
        }
    }
}
