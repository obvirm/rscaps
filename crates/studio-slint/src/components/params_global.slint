// DocParams - shared global mirroring caption-core's CaptionParams for the
// sidebar panels. Rust pushes current values in (on load / template switch)
// via `ui.global::<DocParams>()`; panels write back through the callbacks,
// which Rust wires to `patch_params_json` + overlay invalidate + undo.

// Satu baris control Style data-driven (dari template.json styleControls).
export struct StyleColorItem {
    id: string,
    label: string,
    value: color,
}
export struct StyleFloatItem {
    id: string,
    label: string,
    value: float,
    min: float,
    max: float,
    step: float,
    unit: string,
}

export global DocParams {
    // ── Typography ────────────────────────────────────────────────────────
    // Font size in px at the reference frame (v0 absolute knob).
    in-out property <float> font-size: 110.0;
    in-out property <int> font-weight: 400;
    in-out property <float> letter-spacing: 0.0;   // em
    in-out property <float> word-spacing: 0.0;     // em
    in-out property <float> line-spacing: 0.0;     // em
    in-out property <bool> italic: false;
    in-out property <bool> underline: false;
    in-out property <bool> strikethrough: false;
    // 0=none 1=uppercase 2=lowercase
    in-out property <int> text-case: 0;
    // 0=left 1=center 2=right
    in-out property <int> text-align: 1;
    in-out property <color> color: #ffdd57;

    callback font-size-changed(float);
    callback font-weight-changed(int);
    callback letter-spacing-changed(float);
    callback word-spacing-changed(float);
    callback line-spacing-changed(float);
    callback italic-changed(bool);
    callback underline-changed(bool);
    callback strikethrough-changed(bool);
    callback text-case-changed(int);
    callback text-align-changed(int);
    callback color-changed(color);
    callback reset-typography;

    // ── Position ──────────────────────────────────────────────────────────
    // 0..8 anchor grid (4 = center).
    in-out property <int> anchor: 4;
    in-out property <float> v-offset: 0.0;   // 0..1 from the anchor edge
    in-out property <float> h-offset: 0.0;   // 0..1 from the anchor edge
    in-out property <float> angle: 0.0;      // degrees −180..180
    callback anchor-changed(int);
    callback v-offset-changed(float);
    callback h-offset-changed(float);
    callback angle-changed(float);
    callback reset-position;

    // ── Effects ───────────────────────────────────────────────────────────
    in-out property <bool> fx-gap-free: false;
    in-out property <bool> fx-remove-punct: false;
    in-out property <bool> fx-smart-punct: false;
    in-out property <bool> fx-carry-quotes: false;
    in-out property <bool> fx-smart-lowercase: false;
    // 0=segment-below 1=segment-above 2=word
    in-out property <int> fx-emoji-placement: 0;
    in-out property <float> fx-emoji-size: 1.8;
    in-out property <float> fx-emoji-gap: 0.1;
    callback fx-gap-free-changed(bool);
    callback fx-remove-punct-changed(bool);
    callback fx-smart-punct-changed(bool);
    callback fx-carry-quotes-changed(bool);
    callback fx-smart-lowercase-changed(bool);
    callback fx-emoji-placement-changed(int);
    callback fx-emoji-size-changed(float);
    callback fx-emoji-gap-changed(float);
    callback reset-effects;

    // ── Layout ────────────────────────────────────────────────────────────
    in-out property <int> max-lines: 0;        // 0 = template default
    in-out property <float> max-width-frac: 0.0; // 0 = template default
    in-out property <int> max-chars: 0;        // 0 = template default
    callback max-lines-changed(int);
    callback max-width-frac-changed(float);
    callback max-chars-changed(int);
    callback reset-layout;

    // ── Style (data-driven per template.json) ─────────────────────────────
    // Di-push Rust saat template dipilih (sync_style_controls).
    in property <[StyleColorItem]> style-colors: [];
    in property <[StyleFloatItem]> style-floats: [];
    in property <[string]> style-variants: [];
    in-out property <int> variant-selected: -1;
    callback style-color-changed(string, color);
    callback style-float-changed(string, float);
    callback variant-chosen(int);
    callback reset-style;

    // ── Motion ────────────────────────────────────────────────────────────
    // false = entrance template aktif; true = "static" (diam).
    in-out property <bool> motion-static: false;
    // 0 = template default; selain itu durasi ms.
    in-out property <int> motion-duration-ms: 0;
    // 0 = template default; selain itu jarak em.
    in-out property <float> motion-distance-em: 0.0;
    callback motion-static-changed(bool);
    callback motion-duration-changed(int);
    callback motion-distance-changed(float);
    callback reset-motion;

    // ── Transcript ────────────────────────────────────────────────────────
    // Daftar cue (di-push Rust: "m:ss.mmm–m:ss.mmm  teks").
    in property <[string]> cue-list: [];
    in property <int> cue-count: 0;
    in-out property <int> cue-selected: -1;
    in-out property <string> cue-text: "";
    in-out property <float> cue-start: 0.0;   // seconds
    in-out property <float> cue-end: 0.0;
    callback cue-selected-changed(int);
    callback cue-text-edited(string);
    callback cue-start-changed(float);
    callback cue-end-changed(float);
    callback cue-insert-after;
    callback cue-delete;
}
