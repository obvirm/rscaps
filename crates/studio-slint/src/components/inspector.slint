// Inspector — split from ui.slint (per-component files).
import { CodePanel } from "./code_panel.slint";
import { PlaceholderPanel } from "./placeholder_panel.slint";
import { TemplateItem } from "./template_item.slint";
import { TemplatesPanel } from "./templates_panel.slint";
import { Theme } from "./theme.slint";
import { TypographyPanel } from "./typography_panel.slint";
import { PositionPanel } from "./position_panel.slint";
import { EffectsPanel } from "./effects_panel.slint";
import { LayoutPanel } from "./layout_panel.slint";
import { StylePanel } from "./style_panel.slint";
import { MotionPanel } from "./motion_panel.slint";
import { TranscriptPanel } from "./transcript_panel.slint";


// ── Inspector ──────────────────────────────────────────────────────────────
export component Inspector inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> title;
    in property <string> active-rail;
    in-out property <string> doc-text;
    in-out property <int> template-selected: 0;
    in property <[TemplateItem]> template-viral: [];
    in property <[TemplateItem]> template-modern: [];
    in property <[TemplateItem]> template-classic: [];
    in property <[TemplateItem]> template-key: [];
    in property <[TemplateItem]> template-lab: [];
    in-out property <string> template-search-text: "";
    callback template-search(string);
    in-out property <int> direction-selected: 0;
    callback template-chosen(int);
    callback direction-chosen(int);
    callback apply;
    background: transparent;
    border-radius: Theme.rLg;
    clip: true;
    VerticalLayout {
        Rectangle {
            height: 41px;
            border-color: (root.is-dark ? Theme.border-dark : Theme.border-light); border-width: 1px;
            HorizontalLayout {
                padding-top: 10px; padding-bottom: 10px; padding-left: 14px; padding-right: 14px; spacing: 8px; alignment: center;
                Rectangle { width: 7px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); Rectangle { x: 0; y: (parent.height - 7px) / 2; width: 7px; height: 7px; border-radius: 2px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); } }
                Text { text: root.title; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 13px; font-weight: 600; vertical-alignment: center; }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                padding: 12px;
                if root.active-rail == "templates": TemplatesPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                    template-selected <=> root.template-selected;
                    template-viral: root.template-viral;
                    template-modern: root.template-modern;
                    template-classic: root.template-classic;
                    template-key: root.template-key;
                    template-lab: root.template-lab;
                    search-text <=> root.template-search-text;
                    template-chosen(i) => { root.template-chosen(i); }
                    template-search(t) => { root.template-search(t); }
                }
                if root.active-rail == "code": CodePanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                    doc-text: root.doc-text;
                    direction-selected <=> root.direction-selected;
                    apply => { root.apply(); }
                    direction-chosen(i) => { root.direction-chosen(i); }
                }
                if root.active-rail == "transcript": TranscriptPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "typography": TypographyPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "position": PositionPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "effects": EffectsPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "layout": LayoutPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "style": StylePanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail == "motion": MotionPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                }
                if root.active-rail != "templates" && root.active-rail != "code" && root.active-rail != "transcript" && root.active-rail != "typography" && root.active-rail != "position" && root.active-rail != "effects" && root.active-rail != "layout" && root.active-rail != "style" && root.active-rail != "motion": PlaceholderPanel {
                    is-dark: root.is-dark;
                    horizontal-stretch: 1; vertical-stretch: 1;
                    label: root.title;
                }
            }
        }
    }
}
