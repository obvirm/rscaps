// ExportDialog — split from ui.slint (per-component files).
import { AppButton } from "./app_button.slint";
import { Picker } from "./picker.slint";
import { Theme } from "./theme.slint";


// ── Export dialog ──

// ── Export dialog ──────────────────────────────────────────────────────────
export component ExportDialog inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    property <bool> shown: false;
    in-out property <length> rise: 14px;
    animate rise { duration: 180ms; easing: ease-out; }
    init => { root.shown = true; root.rise = 0px; }
    in property <string> output-summary: "Output 1920 × 1080 · 30 fps · MP4";
    in-out property <int> resolution-selected: 0;
    in-out property <int> format-selected: 0;
    in-out property <int> quality-selected: 2;
    in property <bool> advanced-open: false;
    in property <bool> subtitles-open: false;
    in property <bool> exporting: false;
    in property <string> export-status: "";
    callback do-export;
    callback cancel;
    callback toggle-advanced;
    callback toggle-subtitles;
    callback export-subs(int);
    width: 100%; height: 100%;
    background: #0c0c0eb3;
    backdrop-tap := TouchArea { x: 0; y: 0; width: parent.width; height: parent.height; clicked => { if !root.exporting { root.cancel(); } } }
    panel := Rectangle {
        width: 420px;
        height: root.advanced-open ? 580px : 380px;
        animate height { duration: 300ms; easing: ease-in-out; }
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: 160ms; easing: ease-out; }
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + root.rise;
        background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
        border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light); border-width: 1px;
        border-radius: Theme.rLg;
        drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 3px;
        clip: true;
        VerticalLayout {
            padding-top: 22px; padding-bottom: 18px; padding-left: 22px; padding-right: 22px;
            spacing: 14px;
            Text { text: "Export video"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 20px; font-weight: 600; horizontal-stretch: 0; vertical-stretch: 0; }
            Rectangle {
                vertical-stretch: 0;
                clip: true;
                VerticalLayout {
                    alignment: start;
                    spacing: 14px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: "Resolution"; color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 12px; font-weight: 500; }
                        Picker { is-dark: root.is-dark; options: ["Keep original (1920 × 1080)", "1920 × 1080", "1280 × 720", "854 × 480"]; selected <=> root.resolution-selected; }
                        Text { text: "Output keeps your video's frame rate."; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 11.5px; wrap: word-wrap; }
                    }
                    Rectangle {
                        height: 22px; horizontal-stretch: 0;
                        adv-tap := TouchArea { clicked => { if !root.exporting { root.toggle-advanced(); } } }
                        HorizontalLayout {
                            alignment: start; spacing: 6px;
                            if root.advanced-open: Path {
                                width: 12px; height: 12px;
                                y: (parent.height - self.height) / 2;
                                fill: transparent;
                                stroke: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                                stroke-width: 1.6px;
                                commands: "M 2.5 4 L 6 8 L 9.5 4";
                            }
                            if !root.advanced-open: Path {
                                width: 12px; height: 12px;
                                y: (parent.height - self.height) / 2;
                                fill: transparent;
                                stroke: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                                stroke-width: 1.6px;
                                commands: "M 4 2.5 L 8 6 L 4 9.5";
                            }
                            Text { text: "Advanced options"; color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 12.5px; font-weight: 500; vertical-alignment: center; }
                        }
                    }
                    Rectangle {
                        height: root.advanced-open ? 200px : 0px;
                        clip: true;
                        animate height { duration: 300ms; easing: ease-in-out; }
                        VerticalLayout {
                            alignment: start;
                            spacing: 14px;
                            padding-left: 12px;
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Format"; color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 12px; font-weight: 500; }
                                Picker { is-dark: root.is-dark; options: ["MP4", "WebM"]; selected <=> root.format-selected; }
                                Text { text: root.format-selected == 0 ? "Universal compatibility. Recommended for most uses." : "Smaller files. Best for web playback."; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 11.5px; wrap: word-wrap; }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                Text { text: "Quality"; color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 12px; font-weight: 500; }
                                Picker { is-dark: root.is-dark; options: ["Low", "Medium", "High"]; selected <=> root.quality-selected; }
                                Text { text: root.quality-selected == 2 ? "Recommended for most uploads." : root.quality-selected == 1 ? "Balanced size and quality." : "Smallest file size."; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 11.5px; wrap: word-wrap; }
                            }
                        }
                    }
                    Text { text: root.output-summary; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-family: "IBM Plex Mono"; font-size: 11.5px; }
                    if root.exporting: Text { text: root.export-status; color: (root.is-dark ? Theme.accent-dark : Theme.accent-light); font-size: 12px; }
                }
            }
            HorizontalLayout {
                alignment: space-between; horizontal-stretch: 0; vertical-stretch: 0;
                Rectangle {
                    horizontal-stretch: 0;
                    subs-tap := TouchArea { clicked => { if !root.exporting { root.toggle-subtitles(); } } }
                    HorizontalLayout {
                        Text { text: "Export subtitles instead"; color: subs-tap.has-hover ? (root.is-dark ? Theme.fg0-dark : Theme.fg0-light) : (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 12.5px; vertical-alignment: center; }
                    }
                    if root.subtitles-open: Rectangle {
                        x: 0; y: parent.height + 4px;
                        width: 90px;
                        background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
                        border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light); border-width: 1px;
                        border-radius: Theme.rMd;
                        VerticalLayout {
                            padding: 4px;
                            Rectangle { height: 30px; background: srt-tap.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent; border-radius: Theme.rSm; srt-tap := TouchArea { clicked => { root.export-subs(0); } } Text { x: 9px; y: (parent.height - self.height) / 2; text: "SRT"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 12.5px; } }
                            Rectangle { height: 30px; background: vtt-tap.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent; border-radius: Theme.rSm; vtt-tap := TouchArea { clicked => { root.export-subs(1); } } Text { x: 9px; y: (parent.height - self.height) / 2; text: "VTT"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 12.5px; } }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: end; horizontal-stretch: 0;
                    AppButton { is-dark: root.is-dark; text: "Cancel"; background: (root.is-dark ? Theme.bg2-dark : Theme.bg2-light); border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light); disabled: root.exporting; clicked => { root.cancel(); } }
                    AppButton { is-dark: root.is-dark; text: root.exporting ? "Exporting…" : "Export"; accent: true; disabled: root.exporting; clicked => { root.do-export(); } }
                }
            }
        }
    }
}
