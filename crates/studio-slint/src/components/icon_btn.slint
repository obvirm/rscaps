// IconBtn — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Icon-only square button ────────────────────────────────────────────────
export component IconBtn inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <bool> disabled: false;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: Theme.rSm;
    background: touch.has-hover && !disabled ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
    @children
}
