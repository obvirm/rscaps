// CommandBar — split from ui.slint (per-component files).
import { AppButton } from "./app_button.slint";
import { IconBtn } from "./icon_btn.slint";
import { StatusPill } from "./status_pill.slint";
import { TextField } from "./text_field.slint";
import { Theme } from "./theme.slint";


// ── Command bar ────────────────────────────────────────────────────────────
export component CommandBar inherits Rectangle {
    in-out property <string> project-name;
    in property <string> status;
    in property <bool> status-is-error: false;
    callback back;
    callback export;
    callback import-video;
    callback export-subs(string);
    callback name-edited(string);
    callback toggle-theme;
    in property <bool> is-dark: true;
    // Mode sempit dari Editor (Rust-driven) — sembunyi logo, status,
    // Import, Save agar muat sampai ~270px (paritas tscaps).
    in property <bool> is-narrow: false;
    background: (root.is-dark ? Theme.bg0-dark : Theme.bg0-light);
    height: 49px;
    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: (root.is-dark ? Theme.border-dark : Theme.border-light); }
    HorizontalLayout {
        width: 100%;
        padding-top: 8px; padding-bottom: 8px; padding-left: 14px; padding-right: 14px;
        spacing: 8px;
        alignment: stretch;

        IconBtn { is-dark: root.is-dark; clicked => { root.back(); } Path { x: 8px; y: 8px; width: 16px; height: 16px; fill: transparent; stroke: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); stroke-width: 1.5px; commands: "M 10 3 L 5 8 L 10 13"; } }
        Text { visible: !root.is-narrow; text: "rscaps"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 15px; font-weight: 700; vertical-alignment: center; }
        Rectangle { visible: !root.is-narrow; width: 1px; Rectangle { x: 0; y: (parent.height - 20px) / 2; width: 1px; height: 20px; background: (root.is-dark ? Theme.border-dark : Theme.border-light); } }

        TextField {
            is-dark: root.is-dark;
            width: root.is-narrow ? 80px : 200px;
            text: root.project-name;
            edited(t) => { root.name-edited(t); }
        }

        Rectangle { horizontal-stretch: 1; }

        StatusPill { visible: !root.is-narrow; is-dark: root.is-dark; text: root.status; is-error: root.status-is-error; }
        HorizontalLayout {
            visible: !root.is-narrow;
            spacing: 4px;
            AppButton { is-dark: root.is-dark; text: "Import"; clicked => { root.import-video(); } }
            AppButton { is-dark: root.is-dark; text: ".srt"; clicked => { root.export-subs("srt"); } }
            AppButton { is-dark: root.is-dark; text: ".vtt"; clicked => { root.export-subs("vtt"); } }
        }
            IconBtn { is-dark: root.is-dark; clicked => { root.toggle-theme(); }
            Image {
                x: 9px; y: 9px; width: 14px; height: 14px;
                source: root.is-dark ? @image-url("../assets/icons/moon.svg") : @image-url("../assets/icons/sun.svg");
                colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
            }
        }
        AppButton { visible: !root.is-narrow; is-dark: root.is-dark; text: "Save"; disabled: true; }
        AppButton { is-dark: root.is-dark; text: "Export"; accent: true; clicked => { root.export(); } }
    }
}
