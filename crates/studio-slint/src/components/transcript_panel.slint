// TranscriptPanel - tab "Transcript": daftar cue + editor teks/waktu
// (paritas tscaps TranscriptPanel, MVP tanpa word-level). List di-push Rust
// lewat DocParams.cue-list; edit lewat callback → replace_cues_json.
import { Theme } from "./theme.slint";
import { DocParams } from "./params_global.slint";
import { Section, FieldRow, Slider } from "./controls.slint";
import { AppButton } from "./app_button.slint";
import { TextField } from "./text_field.slint";


export component TranscriptPanel inherits VerticalLayout {
    in property <bool> is-dark: Theme.is-dark;
    spacing: 0px;

    VerticalLayout {
        spacing: 6px;
        padding: 10px;

        // ── Header ──
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: "TRANSCRIPT";
                color: root.is-dark ? Theme.fg2-dark : Theme.fg2-light;
                font-size: 10.5px;
                font-weight: 700;
                letter-spacing: 0.8px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: DocParams.cue-count + " cues";
                color: root.is-dark ? Theme.fg2-dark : Theme.fg2-light;
                font-size: 10.5px;
                vertical-alignment: center;
            }
        }

        // ── Cue list ──
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.rSm;
            background: root.is-dark ? Theme.bg1-dark : Theme.bg1-light;
            border-color: root.is-dark ? Theme.border-dark : Theme.border-light;
            border-width: 1px;
            clip: true;
            if DocParams.cue-list.length == 0: Text {
                width: 100%; height: 100%;
                text: "No cues — import a subtitle file\nor start from New project.";
                color: root.is-dark ? Theme.fg2-dark : Theme.fg2-light;
                font-size: 11.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Flickable {
                VerticalLayout {
                    spacing: 1px;
                    padding: 3px;
                    for item[i] in DocParams.cue-list: Rectangle {
                        height: 34px;
                        border-radius: Theme.rSm;
                        background: i == DocParams.cue-selected
                            ? (root.is-dark ? Theme.bg3-dark : Theme.bg3-light)
                            : (row-touch.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent);
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            spacing: 8px;
                            Text {
                                text: item;
                                color: root.is-dark ? Theme.fg0-dark : Theme.fg0-light;
                                font-size: 11.5px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                        row-touch := TouchArea {
                            width: 100%; height: 100%;
                            clicked => {
                                DocParams.cue-selected = i;
                                DocParams.cue-selected-changed(i);
                            }
                        }
                    }
                }
            }
        }

        // ── Editor (hanya saat ada seleksi) ──
        if DocParams.cue-selected >= 0 && DocParams.cue-selected < DocParams.cue-count: VerticalLayout {
            spacing: 6px;

            Section {
                is-dark: root.is-dark;
                title: "TEXT";
                first: true;
                show-reset: false;
                TextField {
                    horizontal-stretch: 1;
                    text: DocParams.cue-text;
                    edited(t) => { DocParams.cue-text-edited(t); }
                }
            }

            Section {
                is-dark: root.is-dark;
                title: "TIMING";
                show-reset: false;
                FieldRow {
                    is-dark: root.is-dark;
                    label: "Start (s)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 0.0;
                        maximum: 600.0;
                        value <=> DocParams.cue-start;
                        changed(v) => { DocParams.cue-start-changed(v); }
                    }
                }
                FieldRow {
                    is-dark: root.is-dark;
                    label: "End (s)";
                    Slider {
                        is-dark: root.is-dark;
                        minimum: 0.0;
                        maximum: 600.0;
                        value <=> DocParams.cue-end;
                        changed(v) => { DocParams.cue-end-changed(v); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                AppButton {
                    is-dark: root.is-dark;
                    text: "+ Insert after";
                    horizontal-stretch: 1;
                    clicked => { DocParams.cue-insert-after(); }
                }
                AppButton {
                    is-dark: root.is-dark;
                    text: "Delete";
                    horizontal-stretch: 1;
                    clicked => { DocParams.cue-delete(); }
                }
            }
        }
    }
}
