// ProjectCard — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Project card ───────────────────────────────────────────────────────────
export component ProjectCard inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> name;
    in property <string> date;
    in property <string> duration;
    in property <bool> has-thumb: false;
    in property <image> thumb;
    in property <bool> menu-open: false;
    callback open;
    callback toggle-menu;
    callback do-export;
    callback do-delete;
    background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
    border-color: card-tap.has-hover ? (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light) : (root.is-dark ? Theme.border-dark : Theme.border-light);
    border-width: 1px;
    border-radius: Theme.rMd;
    drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    card-tap := TouchArea { clicked => { root.open(); } }
    VerticalLayout {
        Rectangle {
            height: self.width * 9 / 16;
            background: #000000;
            if !root.has-thumb: Text {
                text: "No preview";
                color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                font-family: "IBM Plex Mono";
                font-size: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            if root.has-thumb: Image {
                source: root.thumb;
                x: 0; y: 0; width: 100%; height: 100%;
                image-fit: cover;
            }
            if root.duration != "": Rectangle {
                height: 18px;
                horizontal-stretch: 0;
                background: #000000b3;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 6px; padding-right: 6px;
                    Text { text: root.duration; color: #ffffff; font-family: "IBM Plex Mono"; font-size: 11px; vertical-alignment: center; }
                }
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
            }
        }
        Rectangle {
            VerticalLayout {
                padding-top: 10px; padding-bottom: 11px; padding-left: 12px; padding-right: 12px;
                spacing: 4px;
                Text { text: root.name; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 13.5px; font-weight: 500; overflow: elide; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.date; color: (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 11px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    Rectangle {
                        width: 24px; height: 24px; horizontal-stretch: 0;
                        border-radius: 4px;
                        opacity: card-tap.has-hover || root.menu-open ? 1.0 : 0.0;
                        background: dots-tap.has-hover || root.menu-open ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                        dots-tap := TouchArea { clicked => { root.toggle-menu(); } }
                        Text { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; text: "⋮"; color: dots-tap.has-hover || root.menu-open ? (root.is-dark ? Theme.fg0-dark : Theme.fg0-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light); font-size: 14px; }
                    }
                }
            }
        }
    }
    if root.menu-open: Rectangle {
        x: parent.width - 156px;
        y: parent.height - 44px;
        width: 148px;
        background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
        border-color: (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
        border-width: 1px;
        border-radius: Theme.rMd;
        VerticalLayout {
            padding: 4px;
            Rectangle {
                height: 30px;
                background: ex-tap.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                border-radius: Theme.rSm;
                ex-tap := TouchArea { clicked => { root.do-export(); } }
                HorizontalLayout {
                    padding-left: 9px; padding-right: 9px; spacing: 8px; alignment: start;
                    Text { text: "⤓"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 12px; vertical-alignment: center; }
                    Text { text: "Export"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 12.5px; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 30px;
                background: del-tap.has-hover ? #d453431f : transparent;
                border-radius: Theme.rSm;
                del-tap := TouchArea { clicked => { root.do-delete(); } }
                HorizontalLayout {
                    padding-left: 9px; padding-right: 9px; spacing: 8px; alignment: start;
                    Text { text: "✕"; color: (root.is-dark ? Theme.error-dark : Theme.error-light); font-size: 12px; vertical-alignment: center; }
                    Text { text: "Delete"; color: (root.is-dark ? Theme.error-dark : Theme.error-light); font-size: 12.5px; vertical-alignment: center; }
                }
            }
        }
    }
}
