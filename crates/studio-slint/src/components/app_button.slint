// AppButton — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Button ─────────────────────────────────────────────────────────────────
export component AppButton inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> text;
    in property <bool> accent: false;
    in property <bool> disabled: false;
    in-out property <length> px: 11px;
    in-out property <length> py: 6px;
    horizontal-stretch: 0;
    callback clicked;
    background: accent ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
    border-color: accent ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.border-dark : Theme.border-light);
    border-width: 1px;
    border-radius: Theme.rSm;
    height: py * 2 + 16px;
    opacity: disabled ? 0.45 : 1.0;
    TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: px; padding-right: px;
        alignment: center;
        Text {
            text: root.text;
            color: accent ? (root.is-dark ? Theme.onAccent-dark : Theme.onAccent-light) : (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
            font-size: 12.5px;
            font-weight: 500;
            vertical-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
