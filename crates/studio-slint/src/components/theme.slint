// Theme — split from ui.slint (per-component files).

// ── Design tokens (mirrors studio dark/light themes) ───────────────────────
export global Theme {
    in-out property <bool> is-dark: true;

    // Per-variant constants: subtree copies (theme reveal) bind these
    // through their own is-dark instead of the global one.
    out property <color> bg0-dark: #0c0c0e;       out property <color> bg0-light: #f5f5f3;
    out property <color> bg1-dark: #141416;       out property <color> bg1-light: #ffffff;
    out property <color> bg2-dark: #1c1c1f;       out property <color> bg2-light: #f0f0ee;
    out property <color> bg3-dark: #26262a;       out property <color> bg3-light: #e4e4e2;

    out property <color> fg0-dark: #e8e8ea;       out property <color> fg0-light: #1a1a1c;
    out property <color> fg1-dark: #a0a0a8;       out property <color> fg1-light: #5a5a60;
    out property <color> fg2-dark: #6c6c74;       out property <color> fg2-light: #8a8a90;
    out property <color> onAccent-dark: #ffffff;  out property <color> onAccent-light: #ffffff;

    out property <color> border-dark: #2a2a2e;         out property <color> border-light: #e0e0de;
    out property <color> borderStrong-dark: #404046;   out property <color> borderStrong-light: #c8c8c6;

    out property <color> accent-dark: #e85d3c;    out property <color> accent-light: #c94a2c;
    out property <color> accentHi-dark: #f06e4d;  out property <color> accentHi-light: #b44026;
    out property <color> success-dark: #5a8f7b;   out property <color> success-light: #467864;
    out property <color> warning-dark: #d4a843;   out property <color> warning-light: #a07828;
    out property <color> error-dark: #d45343;     out property <color> error-light: #b43c32;

    out property <color> bg0: is-dark ? bg0-dark : bg0-light;
    out property <color> bg1: is-dark ? bg1-dark : bg1-light;
    out property <color> bg2: is-dark ? bg2-dark : bg2-light;
    out property <color> bg3: is-dark ? bg3-dark : bg3-light;

    out property <color> fg0: is-dark ? fg0-dark : fg0-light;
    out property <color> fg1: is-dark ? fg1-dark : fg1-light;
    out property <color> fg2: is-dark ? fg2-dark : fg2-light;
    out property <color> onAccent: is-dark ? onAccent-dark : onAccent-light;

    out property <color> border: is-dark ? border-dark : border-light;
    out property <color> borderStrong: is-dark ? borderStrong-dark : borderStrong-light;

    out property <color> accent: is-dark ? accent-dark : accent-light;
    out property <color> accentHi: is-dark ? accentHi-dark : accentHi-light;
    out property <color> success: is-dark ? success-dark : success-light;
    out property <color> warning: is-dark ? warning-dark : warning-light;
    out property <color> error: is-dark ? error-dark : error-light;

    out property <length> rSm: 6px;
    out property <length> rMd: 8px;
    out property <length> rLg: 12px;
}
