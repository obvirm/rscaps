// StatusPill — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Status pill ────────────────────────────────────────────────────────────
export component StatusPill inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> text;
    in property <bool> is-error: false;
    background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
    border-color: is-error ? (root.is-dark ? Theme.error-dark : Theme.error-light) : (root.is-dark ? Theme.border-dark : Theme.border-light);
    border-width: 1px;
    border-radius: Theme.rSm;
    height: 24px;
    HorizontalLayout {
        padding-top: 3px; padding-bottom: 3px; padding-left: 8px; padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: is-error ? (root.is-dark ? Theme.error-dark : Theme.error-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
            font-family: "IBM Plex Mono";
            font-size: 11px;
            width: Math.min(self.preferred-width, 344px);
            overflow: elide;
        }
    }
}
