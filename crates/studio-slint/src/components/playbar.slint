// Playbar — transport bar with centered cluster (deliberately NOT tscaps:
// symmetric layout, boxed play, settings popup). Dead controls removed
// (frame field, Render, Raster had no Rust handlers).
import { IconBtn } from "./icon_btn.slint";
import { SettingsPanel } from "./settings_popup.slint";
import { Theme } from "./theme.slint";


// ── Playbar ────────────────────────────────────────────────────────────────
export component Playbar inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <bool> playing;
    in property <string> time-text;
    in property <string> duration-text;
    in property <int> frame;
    in property <int> scrub-max;
    in property <string> rate-text: "1×";
    in-out property <string> guide-mode: "off";
    in property <bool> word-enabled: false;
    // Mode sempit dari Editor (Rust-driven, ambang dihitung dari lebar
    // kolom tengah): transport satu baris butuh ~594px; di bawahnya jadi
    // dua baris agar muat ~270px.
    in property <bool> is-narrow: false;
    callback toggle-play;
    callback seek(int);
    callback rate-step(int);
    callback nav-frame-step(int);
    callback nav-word-step(int);
    callback nav-scene-step(int);
    callback scrub-to(float);
    callback volume-to(float);
    callback mute-toggle;
    callback undo;
    callback redo;
    in property <float> volume: 1.0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    background: (root.is-dark ? Theme.bg1-dark : Theme.bg1-light);
    border-color: (root.is-dark ? Theme.border-dark : Theme.border-light);
    border-width: 1px;
    border-radius: Theme.rMd;
    drop-shadow-color: (root.is-dark ? #141416F2 : #3c322899);
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;
    VerticalLayout {
        padding-top: 10px; padding-bottom: 10px; padding-left: 12px; padding-right: 12px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            height: 20px;
            Rectangle {
                x: 0px; y: (parent.height - 4px) / 2; width: parent.width; height: 4px;
                border-radius: 2px; background: (root.is-dark ? Theme.bg3-dark : Theme.bg3-light);
            }
            Rectangle {
                x: (root.scrub-max > 0 ? (root.frame * 1.0 / root.scrub-max) : 0.0) * (parent.width - 13px);
                y: (parent.height - 13px) / 2; width: 13px; height: 13px;
                border-radius: 6.5px; background: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
            }
            scrub-touch := TouchArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && scrub-touch.pressed)) {
                        root.scrub-to(Math.max(0.0, Math.min(1.0, scrub-touch.mouse-x / scrub-touch.width)));
                    }
                }
            }
        }

        // Centered transport: dua stretch membagi sisa ruang sama rata
        // sehingga cluster play+volume tetap di tengah; box tepi dibuat
        // ramping (time 112, gear 32) agar tak ada area kosong raksasa
        // dan row-min cukup 448px; gear tetap flush right ("kanan mentok").
        if !root.is-narrow : HorizontalLayout {
            spacing: 10px;
            height: 34px;

            Text {
                width: 112px; height: 34px;
                text: root.time-text + " / " + root.duration-text;
                color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                font-family: "IBM Plex Mono";
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 34px; height: 34px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg3-dark : Theme.bg3-light);
                border-color: play-tap.has-hover ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
                border-width: 1px;
                play-tap := TouchArea { clicked => { root.toggle-play(); } }
                Image {
                    x: 10px; y: 10px; width: 14px; height: 14px;
                    source: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                    colorize: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
            }

            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: vol-tap.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                vol-tap := TouchArea { clicked => { root.mute-toggle(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: root.volume <= 0.0 ? @image-url("../assets/icons/volume-x.svg")
                        : root.volume < 0.33 ? @image-url("../assets/icons/volume.svg")
                        : root.volume < 0.66 ? @image-url("../assets/icons/volume-1.svg")
                        : @image-url("../assets/icons/volume-2.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }

            Rectangle {
                width: 80px; height: 34px;
                // Track isi: kiri knob terang (level), kanan redup.
                // kx = posisi knob; tengah knob di kx + 5px.
                // kx dihitung dari LEBAR SENDIRI (self): parent di sini
                // adalah baris penuh, bukan kotak slider 80px.
                property <float> v: Math.max(0.0, Math.min(1.0, root.volume));
                property <length> kx: v * (self.width - 10px);
                Rectangle {
                    x: 0px; y: (parent.height - 3px) / 2; width: kx + 5px; height: 3px;
                    border-radius: 2px; background: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
                Rectangle {
                    x: kx + 10px; y: (parent.height - 3px) / 2; width: parent.width - (kx + 10px); height: 3px;
                    border-radius: 2px; background: (root.is-dark ? Theme.bg3-dark : Theme.bg3-light);
                }
                Rectangle {
                    x: kx;
                    y: (parent.height - 10px) / 2; width: 10px; height: 10px;
                    border-radius: 5px; background: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
                vol-touch := TouchArea {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && vol-touch.pressed)) {
                            root.volume-to(Math.max(0.0, Math.min(1.0, vol-touch.mouse-x / vol-touch.width)));
                        }
                    }
                }
            }

            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: undo-tap.has-hover && root.can-undo ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                opacity: root.can-undo ? 1.0 : 0.4;
                undo-tap := TouchArea { enabled: root.can-undo; clicked => { root.undo(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: @image-url("../assets/icons/undo-2.svg");
                    colorize: root.can-undo ? (root.is-dark ? Theme.fg1-dark : Theme.fg1-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                }
            }

            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: redo-tap.has-hover && root.can-redo ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                opacity: root.can-redo ? 1.0 : 0.4;
                redo-tap := TouchArea { enabled: root.can-redo; clicked => { root.redo(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: @image-url("../assets/icons/redo-2.svg");
                    colorize: root.can-redo ? (root.is-dark ? Theme.fg1-dark : Theme.fg1-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 32px;
                gear := IconBtn {
                    x: parent.width - self.width; y: (parent.height - self.height) / 2;
                    is-dark: root.is-dark;
                    clicked => {
                        if (settings-popup.is-open) { settings-popup.close(); } else { settings-popup.show(); }
                    }
                    Image {
                        x: 8px; y: 8px; width: 16px; height: 16px;
                        source: @image-url("../assets/icons/settings.svg");
                        colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                    }
                }
            }
        }
        // Baris sempit 1: waktu fleksibel + gear (duplikat leaf stateless,
        // id -n agar unik; cuma yang visible yang menerima klik).
        if root.is-narrow : HorizontalLayout {
            spacing: 10px;
            height: 34px;
            Text {
                horizontal-stretch: 1; height: 34px;
                text: root.time-text + " / " + root.duration-text;
                color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                font-family: "IBM Plex Mono";
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 34px; height: 34px;
                gear-n := IconBtn {
                    x: parent.width - self.width; y: (parent.height - self.height) / 2;
                    is-dark: root.is-dark;
                    clicked => {
                        if (settings-popup.is-open) { settings-popup.close(); } else { settings-popup.show(); }
                    }
                    Image {
                        x: 8px; y: 8px; width: 16px; height: 16px;
                        source: @image-url("../assets/icons/settings.svg");
                        colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                    }
                }
            }
        }
        // Baris sempit 2: play + volume + slider fleksibel + undo/redo.
        if root.is-narrow : HorizontalLayout {
            spacing: 10px;
            height: 34px;
            Rectangle {
                width: 34px; height: 34px; border-radius: Theme.rSm;
                background: (root.is-dark ? Theme.bg3-dark : Theme.bg3-light);
                border-color: play-tap-n.has-hover ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.borderStrong-dark : Theme.borderStrong-light);
                border-width: 1px;
                play-tap-n := TouchArea { clicked => { root.toggle-play(); } }
                Image {
                    x: 10px; y: 10px; width: 14px; height: 14px;
                    source: root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                    colorize: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
            }
            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: vol-tap-n.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                vol-tap-n := TouchArea { clicked => { root.mute-toggle(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: root.volume <= 0.0 ? @image-url("../assets/icons/volume-x.svg")
                        : root.volume < 0.33 ? @image-url("../assets/icons/volume.svg")
                        : root.volume < 0.66 ? @image-url("../assets/icons/volume-1.svg")
                        : @image-url("../assets/icons/volume-2.svg");
                    colorize: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                }
            }
            Rectangle {
                horizontal-stretch: 1; min-width: 36px; height: 34px;
                property <float> v-n: Math.max(0.0, Math.min(1.0, root.volume));
                property <length> kx-n: v-n * (self.width - 10px);
                Rectangle {
                    x: 0px; y: (parent.height - 3px) / 2; width: kx-n + 5px; height: 3px;
                    border-radius: 2px; background: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
                Rectangle {
                    x: kx-n + 10px; y: (parent.height - 3px) / 2; width: parent.width - (kx-n + 10px); height: 3px;
                    border-radius: 2px; background: (root.is-dark ? Theme.bg3-dark : Theme.bg3-light);
                }
                Rectangle {
                    x: kx-n;
                    y: (parent.height - 10px) / 2; width: 10px; height: 10px;
                    border-radius: 5px; background: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light);
                }
                vol-touch-n := TouchArea {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    mouse-cursor: pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && vol-touch-n.pressed)) {
                            root.volume-to(Math.max(0.0, Math.min(1.0, vol-touch-n.mouse-x / vol-touch-n.width)));
                        }
                    }
                }
            }
            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: undo-tap-n.has-hover && root.can-undo ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                opacity: root.can-undo ? 1.0 : 0.4;
                undo-tap-n := TouchArea { enabled: root.can-undo; clicked => { root.undo(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: @image-url("../assets/icons/undo-2.svg");
                    colorize: root.can-undo ? (root.is-dark ? Theme.fg1-dark : Theme.fg1-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                }
            }
            Rectangle {
                width: 32px; height: 34px; border-radius: Theme.rSm;
                background: redo-tap-n.has-hover && root.can-redo ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent;
                opacity: root.can-redo ? 1.0 : 0.4;
                redo-tap-n := TouchArea { enabled: root.can-redo; clicked => { root.redo(); } }
                Image {
                    x: 8px; y: 9px; width: 16px; height: 16px;
                    source: @image-url("../assets/icons/redo-2.svg");
                    colorize: root.can-redo ? (root.is-dark ? Theme.fg1-dark : Theme.fg1-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
                }
            }
        }
    }
    settings-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: root.width - 252px;
        y: -308px;
        width: 240px;
        height: 300px;
        SettingsPanel {
            width: parent.width; height: parent.height;
            is-dark: root.is-dark;
            rate-text: root.rate-text;
            guide-mode <=> root.guide-mode;
            word-enabled: root.word-enabled;
            rate-step(d) => { root.rate-step(d); }
            nav-frame-step(d) => { root.nav-frame-step(d); }
            nav-word-step(d) => { root.nav-word-step(d); }
            nav-scene-step(d) => { root.nav-scene-step(d); }
        }
    }
}
