// HomeView — split from ui.slint (per-component files).
import { AppButton } from "./app_button.slint";
import { IconBtn } from "./icon_btn.slint";
import { ProjectCard } from "./project_card.slint";
import { ProjectMeta } from "./project_meta.slint";
import { Theme } from "./theme.slint";


// ── Home view ──────────────────────────────────────────────────────────────
export component HomeView inherits VerticalLayout {
    in property <int> project-count;
    in property <[ProjectMeta]> projects: [];
    in-out property <int> open-menu-index: -1;
    callback new-project;
    callback toggle-theme;
    in property <bool> is-dark: true;
    callback project-open(int);
    callback project-export(int);
    callback project-delete(int);
    spacing: 0px;

    // Svelte parity: .chrome-inner and .shell are max-width 1120 centered,
    // padding 0 20 (border-box). Grid math uses the content column.
    property <length> content-w: Math.min(self.width, 1120px) - 40px;
    property <int> grid-cols: Math.max(1, Math.floor((self.content-w + 16px) / 256px));
    property <length> grid-gap: 16px;
    property <length> card-w: (self.content-w - grid-gap * (grid-cols - 1)) / grid-cols;
    property <length> thumb-h: card-w * 9 / 16;
    property <length> body-h: 60px;
    property <length> card-h: thumb-h + body-h;
    property <int> rows: Math.ceil(projects.length / grid-cols);

    Rectangle {
        height: 60px;
        background: (root.is-dark ? Theme.bg0-dark : Theme.bg0-light);
        border-color: (root.is-dark ? Theme.border-dark : Theme.border-light); border-width: 1px;
        HorizontalLayout {
            width: Math.min(parent.width, 1120px);
            x: (parent.width - self.width) / 2;
            height: parent.height;
            padding-left: 20px; padding-right: 20px; alignment: space-between;
            HorizontalLayout {
                alignment: start; spacing: 0px;
                Text { text: "rs"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 18px; font-weight: 700; vertical-stretch: 1; vertical-alignment: center; }
                Text { text: "caps."; color: (root.is-dark ? Theme.accent-dark : Theme.accent-light); font-size: 18px; font-weight: 700; vertical-stretch: 1; vertical-alignment: center; }
            }
        IconBtn { is-dark: root.is-dark; clicked => { root.toggle-theme(); }
                if root.is-dark: Path {
                    x: 9px; y: 9px; width: 14px; height: 14px;
                    fill: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                    commands: "M 7 0.5 A 6.5 6.5 0 0 0 7 13.5 Z";
                }
                if !root.is-dark: Path {
                    x: 9px; y: 9px; width: 14px; height: 14px;
                    fill: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light);
                    commands: "M 7 4.4 A 2.6 2.6 0 1 0 7 9.6 A 2.6 2.6 0 1 0 7 4.4 Z M 6.4 0 L 7.6 0 L 7.6 1.2 L 6.4 1.2 Z M 6.4 12.8 L 7.6 12.8 L 7.6 14 L 6.4 14 Z M 0 6.4 L 1.2 6.4 L 1.2 7.6 L 0 7.6 Z M 12.8 6.4 L 14 6.4 L 14 7.6 L 12.8 7.6 Z";
                }
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            width: Math.min(parent.width, 1120px);
            x: (parent.width - self.width) / 2;
            padding-top: 40px; padding-bottom: 56px; padding-left: 20px; padding-right: 20px;
            alignment: start;
            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    horizontal-stretch: 0;
                    spacing: 4px; alignment: start;
                    Text { text: "Local projects"; color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 28px; font-weight: 600; }
                    if root.project-count > 0: Text {
                        text: root.project-count == 1 ? "1 project - stored in this browser" : root.project-count + " projects - stored in this browser";
                        color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 13px;
                    }
                }
                AppButton { is-dark: root.is-dark; text: "+ New project"; accent: true; px: 15px; py: 9px; clicked => { root.new-project(); } }
            }
            Rectangle { height: 28px; }
            if root.project-count > 0: Rectangle {
                height: root.rows > 0 ? root.rows * (root.card-h + root.grid-gap) - root.grid-gap : 0px;
                for p[i] in root.projects: ProjectCard { is-dark: root.is-dark;
                    x: Math.mod(i, root.grid-cols) * (root.card-w + root.grid-gap);
                    y: Math.floor(i / root.grid-cols) * (root.card-h + root.grid-gap);
                    width: root.card-w;
                    height: root.card-h;
                    name: p.name;
                    date: p.date;
                    duration: p.duration;
                    has-thumb: p.has-thumb;
                    thumb: p.thumb;
                    menu-open: root.open-menu-index == i;
                    open => { root.project-open(i); }
                    toggle-menu => { root.open-menu-index = root.open-menu-index == i ? -1 : i; }
                    do-export => { root.project-export(i); root.open-menu-index = -1; }
                    do-delete => { root.project-delete(i); root.open-menu-index = -1; }
                }
            }
        }
        // Empty state: absolutely centered group (proven dialog-panel pattern:
        // layouts size to preferred, so centering uses explicit geometry).
        if root.project-count == 0: VerticalLayout {
            x: 0; width: parent.width;
            y: (parent.height - self.height) / 2;
            alignment: center; spacing: 12px;
            Text {
                text: "Make your first project.";
                color: (root.is-dark ? Theme.fg0-dark : Theme.fg0-light); font-size: 26px; font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "Create a project to design captions with fframes. Everything stays in this browser.";
                color: (root.is-dark ? Theme.fg1-dark : Theme.fg1-light); font-size: 13.5px;
                horizontal-alignment: center; wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: center;
                AppButton { is-dark: root.is-dark; text: "+ New project"; accent: true; px: 20px; py: 11px; clicked => { root.new-project(); } }
            }
        }
    }
}
