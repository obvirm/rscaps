// RailIcon — split from ui.slint (per-component files).
import { Theme } from "./theme.slint";


// ── Rail icon (Lucide set, internet — no hand-drawn glyphs) ────────────────
export component RailIcon inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> id;
    in property <color> tint;
    Image {
        x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px;
        source: id == "templates" ? @image-url("../assets/icons/layout-template.svg")
            : id == "transcript" ? @image-url("../assets/icons/captions.svg")
            : id == "typography" ? @image-url("../assets/icons/type.svg")
            : id == "style" ? @image-url("../assets/icons/palette.svg")
            : id == "position" ? @image-url("../assets/icons/move.svg")
            : id == "motion" ? @image-url("../assets/icons/clapperboard.svg")
            : id == "effects" ? @image-url("../assets/icons/sparkles.svg")
            : id == "layout" ? @image-url("../assets/icons/layout-dashboard.svg")
            : @image-url("../assets/icons/code.svg");
        colorize: tint;
    }
}
