// RailItem — split from ui.slint (per-component files).
import { RailIcon } from "./rail_icon.slint";
import { Theme } from "./theme.slint";


// ── Icon rail item ─────────────────────────────────────────────────────────
export component RailItem inherits Rectangle {
    in property <bool> is-dark: Theme.is-dark;
    in property <string> id;
    in property <string> label;
    in property <bool> active: false;
    callback clicked;
    width: 64px;
    height: 58px;
    border-radius: Theme.rMd;
    background: active ? (root.is-dark ? Theme.bg3-dark : Theme.bg3-light) : (touch.has-hover ? (root.is-dark ? Theme.bg2-dark : Theme.bg2-light) : transparent);
    touch := TouchArea { clicked => { root.clicked(); } }
    RailIcon {
        is-dark: root.is-dark;
        id: root.id;
        tint: active ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (touch.has-hover ? (root.is-dark ? Theme.fg1-dark : Theme.fg1-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light));
        width: 18px; height: 18px;
        x: (parent.width - self.width) / 2;
        y: 7px;
    }
    Text {
        y: 31px; width: parent.width; height: 16px;
        text: root.label;
        color: active ? (root.is-dark ? Theme.accent-dark : Theme.accent-light) : (root.is-dark ? Theme.fg2-dark : Theme.fg2-light);
        font-size: 10px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if active: Rectangle { x: 4px; y: 4px; width: 6px; height: 1.5px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: 4px; y: 4px; width: 1.5px; height: 6px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: parent.width - 10px; y: 4px; width: 6px; height: 1.5px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: parent.width - 5.5px; y: 4px; width: 1.5px; height: 6px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: 4px; y: parent.height - 5.5px; width: 6px; height: 1.5px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: 4px; y: parent.height - 10px; width: 1.5px; height: 6px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: parent.width - 10px; y: parent.height - 5.5px; width: 6px; height: 1.5px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
    if active: Rectangle { x: parent.width - 5.5px; y: parent.height - 10px; width: 1.5px; height: 6px; background: (root.is-dark ? Theme.accent-dark : Theme.accent-light); }
}
