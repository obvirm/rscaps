// App shell — components live in ./components/ (per-component files).
import { EditorView } from "./components/editor_view.slint";
import { ExportDialog } from "./components/export_dialog.slint";
import { HomeView } from "./components/home_view.slint";
import { NewProjectDialog } from "./components/new_project_dialog.slint";
import { ProjectMeta } from "./components/project_meta.slint";
import { TemplateItem } from "./components/template_item.slint";
import { Theme } from "./components/theme.slint";
import { TranscribeOverlay } from "./components/transcribe_overlay.slint";


// ── App root ───────────────────────────────────────────────────────────────
export component App inherits Window {
    title: "rscaps";
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.bg0;

    in-out property <string> route: "home";
    in-out property <bool> app-is-dark: true;
    callback theme-toggled(bool);
    changed app-is-dark => { Theme.is-dark = root.app-is-dark; }
    property <bool> theme-reveal-visible: false;
    property <bool> theme-reveal-open: false;
    property <bool> theme-reveal-armed: false;
    property <bool> theme-reveal-cooldown: false;
    property <bool> theme-reveal-to-dark: true;
    property <length> theme-reveal-origin-x: route == "home" ? (root.width - Math.min(root.width, 1120px)) / 2 + Math.min(root.width, 1120px) - 36px : root.width - 123px;
    property <length> theme-reveal-origin-y: route == "home" ? 30px : 24px;
    property <length> theme-reveal-radius: theme-reveal-open ? root.width + root.height : 0px;
    animate theme-reveal-radius { duration: 450ms; }

    function start-theme-reveal() {
        // Klik dikunci selama animasi (450ms) dan cooldown 500ms sesudahnya
        // (rate limit: tombol tema tidak boleh dipencet cepat beruntun).
        if (root.theme-reveal-visible || root.theme-reveal-cooldown) { return; }
        root.theme-reveal-to-dark = !Theme.is-dark;
        root.theme-reveal-visible = true;
        root.theme-reveal-open = false;
        root.theme-reveal-armed = true;
    }

    in-out property <int> project-count: 0;
    in-out property <[ProjectMeta]> projects: [];
    in-out property <int> open-menu-index: -1;
    callback new-project;
    callback project-open(int);
    callback project-export(int);
    callback project-delete(int);

    in property <bool> show-new-project: false;
    in-out property <string> np-video-name: "";
    in-out property <string> np-video-meta: "";
    in-out property <string> np-name: "Untitled";
    in-out property <int> np-template-selected: 19;
    in-out property <int> np-backend-selected: 0;
    in-out property <int> np-model-selected: 1;
    in-out property <int> np-language-selected: 0;
    in-out property <int> np-direction-selected: 0;
    in property <bool> np-advanced-open: false;
    in property <bool> np-creating: false;
    callback np-start;
    callback np-cancel;
    callback np-use-subtitle;
    callback np-toggle-advanced;

    in property <bool> show-export: false;
    in-out property <string> ex-summary: "Output 1920 × 1080 · 30 fps · MP4";
    in-out property <int> ex-resolution-selected: 0;
    in-out property <int> ex-format-selected: 0;
    in-out property <int> ex-quality-selected: 2;
    in property <bool> ex-advanced-open: false;
    in property <bool> ex-subtitles-open: false;
    in property <bool> ex-exporting: false;
    in property <string> ex-status: "";
    callback ex-export;
    callback ex-cancel;
    callback ex-toggle-advanced;
    callback ex-toggle-subtitles;
    callback ex-export-subs(int);

    in property <bool> show-transcribe: false;
    in property <bool> probe-pending: false;
    in-out property <int> tr-pct: 0;
    in-out property <string> tr-title: "Preparing the engine.";
    in-out property <string> tr-sub: "Loading the transcription engine.";

    in-out property <string> project-name: "Untitled";
    in-out property <string> status: "ready";
    in property <bool> status-is-error: false;
    in-out property <string> active-rail: "templates";
    in-out property <string> doc-text: "{}";
    in-out property <int> template-selected: 0;
    in-out property <int> direction-selected: 0;
    // Model galeri template per seksi (didorong Rust) + teks search.
    in property <[TemplateItem]> template-viral: [];
    in property <[TemplateItem]> template-modern: [];
    in property <[TemplateItem]> template-classic: [];
    in property <[TemplateItem]> template-key: [];
    in property <[TemplateItem]> template-lab: [];
    in-out property <string> template-search-text: "";
    callback template-search(string);
    in property <bool> has-video: false;
    in property <float> video-aspect: 16 / 9;
    in property <string> stage-chip: "frame 0 - 0.00s";
    in property <bool> playing: false;
    in property <string> time-text: "0:00.000";
    in property <string> duration-text: "0:00.000";
    // Teks cue aktif untuk overlay preview (didorong Rust tiap frame).
    in property <string> overlay-text: "";
    // Gaya overlay template (didorong Rust saat kartu diklik).
    in property <float> overlay-fs: 7.0;
    in property <int> overlay-fw: 800;
    in property <color> overlay-fg: #ffffff;
    in property <color> overlay-bg: #000000;
    in property <bool> overlay-bg-on: false;
    in property <float> overlay-br: 0.0;
    in property <float> overlay-pdx: 0.0;
    in property <float> overlay-pdy: 0.0;
    in property <float> overlay-y: 0.82;
    in property <string> overlay-fam: "";
    // Overlay caption asli render_frame (paritas main).
    in property <image> overlay-image;
    in property <bool> overlay-live: false;
    in property <int> frame: 0;
    in property <int> scrub-max: 1;
    callback back;
    callback export;
    callback name-edited(string);
    callback template-chosen(int);
    callback direction-chosen(int);
    callback apply;
    callback toggle-play;
    callback seek(int);
    callback rate-step(int);
    callback nav-frame-step(int);
    callback nav-word-step(int);
    callback nav-scene-step(int);
    in-out property <image> preview-image;
    callback pump-frame;
    callback import-video;
    callback attach-video;
    callback export-subs(string);
    callback scrub-to(float);
    callback volume-to(float);
    callback mute-toggle;
    callback undo;
    callback redo;
    in-out property <string> rate-text: "1×";
    in property <bool> word-enabled: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    // State visual milik bersama (salinan reveal wajib ikut agar tak glitch).
    in-out property <length> inspector-w: 320px;
    in-out property <string> guide-mode: "off";
    in-out property <float> volume-frac: 1.0;
    callback tr-cancel;
    callback tr-done;
    callback np-check;
    // Responsive (Rust-driven — lihat width-poll): jendela sempit menumpuk.
    in property <bool> win-narrow: false;
    in property <bool> playbar-narrow: false;
    callback poll-width;

    // Progress is driven by the real engine from Rust now; this only
    // fires completion once pct reaches 100 (backstop).
    tr-timer := Timer {
        interval: 50ms;
        running: root.show-transcribe && root.tr-pct >= 100;
        triggered => { root.tr-done(); }
    }

    // Probe pump: DOM video events fill plain Rust state outside Slint's
    // event loop; this timer carries finished probes into the UI from
    // inside the loop, where structural changes reliably apply.
    probe-timer := Timer {
        interval: 200ms;
        running: root.probe-pending;
        triggered => { root.np-check(); }
    }

    // Frame pump: while playing, Rust copies the current video frame
    // into preview-image ~30x/s (low-res preview, reference-sanctioned).
    // Frame pump: 10ms tick = phase granularity vs vsync (any Hz);
    // Rust only grabs when a new video frame is due, so no wasted
    // uploads. 33ms pump vs 10ms vsync juddered (3.33 vsync/frame).
    // Width poll untuk layout responsif: backstop 120ms, jalan instan
    // lewat event resize Rust (tanpa debounce — langsung mode android).
    width-poll := Timer {
        interval: 120ms;
        running: true;
        triggered => { root.poll-width(); }
    }
    frame-pump := Timer {
        interval: 10ms;
        running: root.has-video && root.playing;
        triggered => { root.pump-frame(); }
    }

    theme-reveal-start-timer := Timer {
        interval: 16ms;
        running: root.theme-reveal-armed;
        triggered => {
            root.theme-reveal-armed = false;
            root.theme-reveal-open = true;
        }
    }

    theme-reveal-settle-timer := Timer {
        interval: 450ms;
        // Ikat ke visible (idiom sama dgn start-timer): timer hidup hanya
        // selama reveal berjalan dan mati sendiri saat visible=false di
        // bawah. Tanpa restart() mentah & tanpa runaway (codegen default
        // running=true bikin timer menyala terus sejak boot).
        running: root.theme-reveal-visible;
        triggered => {
            root.app-is-dark = root.theme-reveal-to-dark;
            root.theme-toggled(root.theme-reveal-to-dark);
            root.theme-reveal-visible = false;
            root.theme-reveal-open = false;
            root.theme-reveal-armed = false;
            root.theme-reveal-cooldown = true;
        }
    }

    theme-reveal-cooldown-timer := Timer {
        interval: 500ms;
        // Ikat ke properti (idiom aman — hindari codegen default running=true).
        running: root.theme-reveal-cooldown;
        triggered => {
            root.theme-reveal-cooldown = false;
        }
    }

    init => { key-scope.focus(); }
    // Navigator hold-keys (settings popup hints): F/W/S held + arrows.
    // Letters are consumed by focused text fields first, so typing is safe.
    property <bool> f-held: false;
    property <bool> w-held: false;
    property <bool> s-held: false;
    key-scope := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show-new-project) { root.np-cancel(); }
                else if (root.show-export) { root.ex-cancel(); }
                else if (root.show-transcribe) { root.tr-cancel(); }
                accept
            }
            if (root.route == "editor" && !root.show-new-project && !root.show-export && !root.show-transcribe) {
                if (event.text == "f" || event.text == "F") { root.f-held = true; accept }
                if (event.text == "w" || event.text == "W") { root.w-held = true; accept }
                if (event.text == "s" || event.text == "S") { root.s-held = true; accept }
                if (event.text == Key.LeftArrow) {
                    if (root.f-held) { root.nav-frame-step(-1); accept }
                    if (root.w-held) { root.nav-word-step(-1); accept }
                    if (root.s-held) { root.nav-scene-step(-1); accept }
                }
                if (event.text == Key.RightArrow) {
                    if (root.f-held) { root.nav-frame-step(1); accept }
                    if (root.w-held) { root.nav-word-step(1); accept }
                    if (root.s-held) { root.nav-scene-step(1); accept }
                }
            }
            reject
        }
        key-released(event) => {
            if (event.text == "f" || event.text == "F") { root.f-held = false; accept }
            if (event.text == "w" || event.text == "W") { root.w-held = false; accept }
            if (event.text == "s" || event.text == "S") { root.s-held = false; accept }
            reject
        }
    if root.route == "home": HomeView {
        width: 100%; height: 100%;
        project-count: root.project-count;
        projects: root.projects;
        open-menu-index <=> root.open-menu-index;
        is-dark: Theme.is-dark;
        new-project => { root.new-project(); }
        toggle-theme => { root.start-theme-reveal(); }
        project-open(i) => { root.project-open(i); }
        project-export(i) => { root.project-export(i); }
        project-delete(i) => { root.project-delete(i); }
    }
    if root.route == "editor": EditorView {
        width: 100%; height: 100%;
        project-name: root.project-name;
        status: root.status;
        status-is-error: root.status-is-error;
        active-rail: root.active-rail;
        doc-text: root.doc-text;
        template-selected <=> root.template-selected;
        direction-selected <=> root.direction-selected;
        template-viral: root.template-viral;
        template-modern: root.template-modern;
        template-classic: root.template-classic;
        template-key: root.template-key;
        template-lab: root.template-lab;
        template-search-text <=> root.template-search-text;
        has-video: root.has-video;
        video-aspect: root.video-aspect;
        stage-chip: root.stage-chip;
        preview-image: root.preview-image;
        overlay-text: root.overlay-text;
        overlay-fs: root.overlay-fs;
        overlay-fw: root.overlay-fw;
        overlay-fg: root.overlay-fg;
        overlay-bg: root.overlay-bg;
        overlay-bg-on: root.overlay-bg-on;
        overlay-br: root.overlay-br;
        overlay-pdx: root.overlay-pdx;
        overlay-pdy: root.overlay-pdy;
        overlay-y: root.overlay-y;
        overlay-fam: root.overlay-fam;
        overlay-image: root.overlay-image;
        overlay-live: root.overlay-live;
        playing: root.playing;
        time-text: root.time-text;
        duration-text: root.duration-text;
        frame: root.frame;
        scrub-max: root.scrub-max;
        back => { root.back(); }
        export => { root.export(); }
        name-edited(t) => { root.name-edited(t); }
        template-chosen(i) => { root.template-chosen(i); }
        template-search(t) => { root.template-search(t); }
        direction-chosen(i) => { root.direction-chosen(i); }
        apply => { root.apply(); }
        toggle-play => { root.toggle-play(); }
        seek(f) => { root.seek(f); }
        rate-step(d) => { root.rate-step(d); }
        nav-frame-step(d) => { root.nav-frame-step(d); }
        nav-word-step(d) => { root.nav-word-step(d); }
        nav-scene-step(d) => { root.nav-scene-step(d); }
        undo => { root.undo(); }
        redo => { root.redo(); }
        can-undo: root.can-undo;
        can-redo: root.can-redo;
        volume-frac: root.volume-frac;
        scrub-to(f) => { root.scrub-to(f); }
        volume-to(f) => { root.volume-to(f); }
        mute-toggle => { root.mute-toggle(); }
        rate-text: root.rate-text;
        word-enabled: root.word-enabled;
        inspector-w <=> root.inspector-w;
        guide-mode <=> root.guide-mode;
        is-narrow: root.win-narrow;
        playbar-narrow: root.playbar-narrow;
        is-dark: Theme.is-dark;
        toggle-theme => { root.start-theme-reveal(); }
    }

    if root.show-new-project: NewProjectDialog {
        is-dark: Theme.is-dark;
        video-name: root.np-video-name;
        video-meta: root.np-video-meta;
        name <=> root.np-name;
        template-selected <=> root.np-template-selected;
        backend-selected <=> root.np-backend-selected;
        model-selected <=> root.np-model-selected;
        language-selected <=> root.np-language-selected;
        direction-selected <=> root.np-direction-selected;
        advanced-open: root.np-advanced-open;
        creating: root.np-creating;
        create => { root.np-start(); }
        cancel => { root.np-cancel(); }
        use-subtitle => { root.np-use-subtitle(); }
        toggle-advanced => { root.np-toggle-advanced(); }
    }
    if root.show-export: ExportDialog {
        is-dark: Theme.is-dark;
        output-summary: root.ex-summary;
        resolution-selected <=> root.ex-resolution-selected;
        format-selected <=> root.ex-format-selected;
        quality-selected <=> root.ex-quality-selected;
        advanced-open: root.ex-advanced-open;
        subtitles-open: root.ex-subtitles-open;
        exporting: root.ex-exporting;
        export-status: root.ex-status;
        do-export => { root.ex-export(); }
        cancel => { root.ex-cancel(); }
        toggle-advanced => { root.ex-toggle-advanced(); }
        toggle-subtitles => { root.ex-toggle-subtitles(); }
        export-subs(i) => { root.ex-export-subs(i); }
    }
    if root.show-transcribe: TranscribeOverlay {
        is-dark: Theme.is-dark;
        pct: root.tr-pct;
        title: root.tr-title;
        sub: root.tr-sub;
        cancel => { root.tr-cancel(); }
    }
    if root.theme-reveal-visible: Rectangle {
        x: root.theme-reveal-origin-x - root.theme-reveal-radius;
        y: root.theme-reveal-origin-y - root.theme-reveal-radius;
        width: root.theme-reveal-radius * 2;
        height: root.theme-reveal-radius * 2;
        border-radius: root.theme-reveal-radius;
        background: root.theme-reveal-to-dark ? #0c0c0e : #f5f5f3;
        clip: true;
        // Salinan view dengan theme BARU: elemen tetap terlihat di dalam
        // lingkaran selama animasi. Callbacks dibiarkan no-op; TouchArea
        // terakhir menelan klik selama 450ms.
        if root.route == "home": HomeView {
            x: root.theme-reveal-radius - root.theme-reveal-origin-x;
            y: root.theme-reveal-radius - root.theme-reveal-origin-y;
            width: root.width; height: root.height;
            is-dark: root.theme-reveal-to-dark;
            project-count: root.project-count;
            projects: root.projects;
            open-menu-index: root.open-menu-index;
            toggle-theme => { root.start-theme-reveal(); }
        }
        if root.route == "editor": EditorView {
            x: root.theme-reveal-radius - root.theme-reveal-origin-x;
            y: root.theme-reveal-radius - root.theme-reveal-origin-y;
            width: root.width; height: root.height;
            is-dark: root.theme-reveal-to-dark;
            project-name: root.project-name;
            status: root.status;
            status-is-error: root.status-is-error;
            active-rail: root.active-rail;
            doc-text: root.doc-text;
            template-selected: root.template-selected;
            direction-selected: root.direction-selected;
            template-viral: root.template-viral;
            template-modern: root.template-modern;
            template-classic: root.template-classic;
            template-key: root.template-key;
            template-lab: root.template-lab;
            template-search-text: root.template-search-text;
            has-video: root.has-video;
            video-aspect: root.video-aspect;
            stage-chip: root.stage-chip;
            playing: root.playing;
            time-text: root.time-text;
            duration-text: root.duration-text;
            frame: root.frame;
            scrub-max: root.scrub-max;
            preview-image: root.preview-image;
        overlay-text: root.overlay-text;
        overlay-fs: root.overlay-fs;
        overlay-fw: root.overlay-fw;
        overlay-fg: root.overlay-fg;
        overlay-bg: root.overlay-bg;
        overlay-bg-on: root.overlay-bg-on;
        overlay-br: root.overlay-br;
        overlay-pdx: root.overlay-pdx;
        overlay-pdy: root.overlay-pdy;
        overlay-y: root.overlay-y;
        overlay-fam: root.overlay-fam;
        overlay-image: root.overlay-image;
        overlay-live: root.overlay-live;
            volume-frac: root.volume-frac;
            inspector-w: root.inspector-w;
            guide-mode: root.guide-mode;
            is-narrow: root.win-narrow;
            playbar-narrow: root.playbar-narrow;
            rate-text: root.rate-text;
            word-enabled: root.word-enabled;
            can-undo: root.can-undo;
            can-redo: root.can-redo;
            toggle-theme => { root.start-theme-reveal(); }
        }
        // Perisai klik berlubang 32x32 tepat di tombol tema (pusat lingkaran):
        // klik cepat menjangkau tombol salinan (fungsional) untuk membalik
        // arah; area lain tetap tertelan selama 450ms.
        TouchArea { x: 0px; y: 0px; width: Math.max(root.theme-reveal-radius - 16px, 0px); height: root.theme-reveal-radius * 2; }
        TouchArea { x: root.theme-reveal-radius + 16px; y: 0px; width: Math.max(root.theme-reveal-radius - 16px, 0px); height: root.theme-reveal-radius * 2; }
        TouchArea { x: Math.max(root.theme-reveal-radius - 16px, 0px); y: 0px; width: 32px; height: Math.max(root.theme-reveal-radius - 16px, 0px); }
        TouchArea { x: Math.max(root.theme-reveal-radius - 16px, 0px); y: root.theme-reveal-radius + 16px; width: 32px; height: Math.max(root.theme-reveal-radius - 16px, 0px); }
    }
    }
}
